---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Sidebar from '../components/Sidebar.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const sidebarGroups = {
  sections: [
    {
      label: 'ABOUT_OSTK',
      items: [
        { icon: 'help_outline', label: 'WHY_OSTK', href: '/why/' },
        { icon: 'layers', label: 'THE_STACK', href: '/stack/' },
        { icon: 'rocket_launch', label: 'START_HERE', href: '/start/' },
      ],
    },
    {
      label: 'LINEAGE_AND_GOVERNANCE',
      items: [
        { icon: 'auto_stories', label: 'DOCTRINE', href: '/doctrine/' },
        { icon: 'gavel', label: 'GOVERNANCE', href: '/governance/' },
        { icon: 'info', label: 'ABOUT', href: '/about/' },
        { icon: 'history', label: 'CHANGELOG', href: '/changelog/' },
      ],
    },
  ],
  bottomItems: [
    { icon: 'menu_book', label: 'ALL_DOCS', href: '/docs/' },
    { icon: 'code', label: 'SOURCE', href: 'https://github.com/os-tack/ostk.ai' },
  ],
};
---

<Base title="Governance" description="How ostk governs itself through signed local documents, identity-derived trust, capability policy, and explicit operating laws.">
  <Sidebar title="GOVERNANCE" subtitle="TRUST_CHAIN" groups={sidebarGroups} />

  <main id="main-content" class="flex-1 md:ml-64 pt-16 pb-12 px-4 md:px-10">
    <div class="max-w-4xl mx-auto py-12">
      <Breadcrumb crumbs={[
        { label: 'OSTK', href: '/' },
        { label: 'Governance' },
      ]} />

      <div class="section-label mb-4">GOVERNANCE // OVERVIEW</div>
      <h1 class="serif-text text-6xl font-bold tracking-tighter text-on-surface mb-6">Governance</h1>
      <p class="font-headline text-lg text-on-surface-variant italic leading-relaxed max-w-2xl mb-16">
        ostk keeps governance in signed, inspectable project documents rather than a hosted permissions dashboard. Identity evidence and capability policy stay local.
      </p>

      <!-- Governance documents -->
      <section class="mb-16">
        <h2 class="section-label mb-6">GOVERNANCE_DOCUMENTS</h2>
        <div class="space-y-px">
          {[
            { doc: 'HUMANFILE', governs: 'Models, secrets, trust policy, pin defaults, operator identity', who: 'T0 only', href: '/docs/configuration/#humanfile' },
            { doc: 'ENTITYFILE', governs: 'OS identity, key registry, fleet state, laws', who: 'T0 only (negotiate protocol)', href: '/docs/configuration/#entityfile' },
            { doc: '.primefile', governs: 'Project identity evidence, kernel version, signing authority, lineage', who: 'Created by init; verified at boot', href: '/docs/configuration/#primefile' },
            { doc: 'Agentfile', governs: 'Agent model, prompt, tools, limits, isolation, attestation', who: 'T0 or T1 (signed)', href: '/docs/agentfile/' },
          ].map(d => (
            <div class="bg-surface-container grid grid-cols-1 md:grid-cols-12">
              <div class="md:col-span-3 bg-surface-container-low px-4 py-4">
                <a href={d.href} class="font-body text-sm text-primary hover:underline font-bold">{d.doc}</a>
              </div>
              <div class="md:col-span-6 px-4 py-4">
                <span class="font-body text-xs text-secondary">{d.governs}</span>
              </div>
              <div class="md:col-span-3 px-4 py-4">
                <span class="font-body text-xs text-outline">{d.who}</span>
              </div>
            </div>
          ))}
        </div>
        <p class="font-body text-xs text-secondary mt-4">
          The <code class="text-primary">modify-governance</code> token denies these writes for T1 and lower by default. Operator-authored pin profiles may declare explicit path exceptions. <a href="/docs/security/#capability-pins-profiles" class="text-primary hover:underline">→ Capability Pins</a>
        </p>
      </section>

      <!-- Trust tiers summary -->
      <section class="mb-16">
        <h2 class="serif-text text-3xl font-medium text-on-surface mb-6">Trust Tiers</h2>
        <p class="font-body text-xs text-secondary mb-6 max-w-lg">
          Identity resolves from HUMANFILE and a verified primefile first, with GPG as a fallback. Four tiers define the default posture from full governance to anonymous.
        </p>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-px bg-surface-variant mb-4">
          {[
            { tier: 'T0', label: 'Full governance', desc: 'Verified local or configured trust root.' },
            { tier: 'T1', label: 'Guarded source writes', desc: 'Identity endorsed by a T0 root.' },
            { tier: 'T2', label: 'Read-oriented', desc: 'Identity present without T0 endorsement.' },
            { tier: 'T3', label: 'Anonymous', desc: 'No resolved identity; writes denied by default.' },
          ].map(t => (
            <div class="bg-surface-container p-5">
              <span class="serif-text text-2xl font-bold text-primary">{t.tier}</span>
              <div class="font-body text-xs text-on-surface mt-1">{t.label}</div>
              <div class="font-body text-[10px] text-outline mt-1">{t.desc}</div>
            </div>
          ))}
        </div>
        <p class="font-body text-xs text-secondary">
          Full details: <a href="/docs/security/#identity-derived-trust-tiers" class="text-primary hover:underline">Trust Model</a>
        </p>
      </section>

      <!-- Five Laws summary -->
      <section class="mb-16">
        <h2 class="serif-text text-3xl font-medium text-on-surface mb-6">The Five Laws</h2>
        <div class="bg-surface-container-low p-6 border-l-2 border-primary">
          {[
            { num: '01', law: 'The project surface stays familiar' },
            { num: '02', law: 'Durable state outlives a process' },
            { num: '03', law: 'Coordinate through the filesystem' },
            { num: '04', law: 'Optimistic concurrency' },
            { num: '05', law: 'Infrastructure should stay inspectable' },
          ].map(l => (
            <div class="flex items-center gap-4 py-2 border-b border-surface-variant last:border-b-0">
              <span class="font-body text-xs text-primary font-bold">{l.num}</span>
              <span class="font-body text-sm text-on-surface">{l.law}</span>
            </div>
          ))}
        </div>
        <p class="font-body text-xs text-secondary mt-4">
          These principles describe the intended architecture; each implementation claim still needs a named scope and verification evidence. <a href="/docs/architecture/#the-five-foundational-laws" class="text-primary hover:underline">→ Five principles in practice</a>
        </p>
      </section>

      <!-- Signing chain -->
      <section class="mb-16">
        <h2 class="section-label mb-6">SIGNING_CHAIN</h2>
        <div class="space-y-px">
          {[
            { step: '01', stage: 'DEVELOPMENT', desc: 'Commits follow the repository\'s configured author-signing policy' },
            { step: '02', stage: 'RELEASE', desc: 'Repository commit signed by the institutional key (@ostk.ai)' },
            { step: '03', stage: 'BINARY', desc: 'Release binaries signed by the CI key (cross-signed by root)' },
            { step: '04', stage: 'VERIFICATION', desc: 'Any user can verify any artifact against the public key' },
          ].map(s => (
            <div class="bg-surface-container grid grid-cols-1 md:grid-cols-12">
              <div class="md:col-span-1 bg-surface-container-low flex items-center justify-center py-3">
                <span class="serif-text text-lg font-bold text-primary">{s.step}</span>
              </div>
              <div class="md:col-span-3 px-4 py-3">
                <span class="font-body text-xs text-on-surface font-bold">{s.stage}</span>
              </div>
              <div class="md:col-span-8 px-4 py-3">
                <span class="font-body text-xs text-secondary">{s.desc}</span>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Source availability -->
      <section class="mb-16">
        <div class="bg-surface-container-high p-6 border-t-4 border-primary">
          <h2 class="serif-text text-xl font-medium text-on-surface mb-3">Source Availability & Open Source Transition</h2>
          <p class="font-body text-xs text-on-surface mb-2">
            The <code>ostk</code> framework has transitioned to public repositories. All runtime elements — the daemon CLI (<code>ostk</code>), prompt cache (<code>ostk-cache</code>), and memory MCP server (<code>ostk-recall</code>) — are open-source under the <strong>GNU Affero General Public License v3.0 (AGPL-3.0)</strong>.
          </p>
          <p class="font-body text-xs text-secondary">
            The userspace client library (<code>libostk</code>) is licensed under the permissive <strong>MIT License</strong> to allow seamless programmatic integrations.
          </p>
        </div>
      </section>

      <div class="metadata-ribbon border-t border-surface-variant">
        <span class="font-label text-[10px] text-secondary mr-4">RELATED:</span>
        <a href="/docs/security/#identity-derived-trust-tiers"><Icon name="shield" size="14" class="align-middle mr-1" />TRUST_MODEL</a>
        <a href="/docs/security/#capability-pins-profiles"><Icon name="pin_drop" size="14" class="align-middle mr-1" />CAPABILITY_PINS</a>
        <a href="/docs/configuration/#entityfile"><Icon name="groups" size="14" class="align-middle mr-1" />ENTITYFILE</a>
        <a href="/docs/architecture/#the-five-foundational-laws"><Icon name="gavel" size="14" class="align-middle mr-1" />FIVE_LAWS</a>
      </div>
    </div>
  </main>
</Base>
