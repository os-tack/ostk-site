---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';

const orientationChecks = [
  {
    number: '01',
    label: 'Active task',
    body: 'The single open task and its acceptance condition.',
  },
  {
    number: '02',
    label: 'Decision + rationale',
    body: 'The recorded rounding policy and why it was chosen.',
  },
  {
    number: '03',
    label: 'Changed file state',
    body: 'The partial edit and handoff marker in src/pricing.py.',
  },
  {
    number: '04',
    label: 'Exact next action',
    body: 'The remaining implementation, test, and close sequence.',
  },
];

const limitations = [
  'The checker validates a bounded continuity run. It is not an adversarial identity proof.',
  'Journal fields do not independently attest that an external process was a particular named coding agent.',
  'The no-transcript condition is enforced by the person running the demo; the checker cannot prove that nothing was pasted.',
  'A pass does not establish provider or router failover, fresh-machine restore, projection rebuilds, data-egress policy, or concurrent-edit behavior.',
];

const nextPaths = [
  {
    icon: 'cpu',
    title: 'Use local inference',
    body: 'Continue with a configured local-model route and its explicit capability limits.',
    href: '/start/local/',
    action: 'Open the local path',
  },
  {
    icon: 'users',
    title: 'Coordinate a team or CI',
    body: 'Move from a two-session demo into shared-agent and automation patterns.',
    href: '/start/server/',
    action: 'Open the team path',
  },
  {
    icon: 'layers',
    title: 'Understand the system',
    body: 'Read how the project layer, integrations, and internal components fit together.',
    href: '/stack/',
    action: 'See how it works',
  },
];
---

<Base
  marketing
  activeTab="start"
  title="AI Coding Agent Handoff Demo — ostk"
  description="Run a five-minute AI coding agent handoff demo and verify that a fresh supported session can recover the task, rationale, changed file, and next action."
>
  <main id="main-content" class="start-page flex-1">
    <section class="start-hero">
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="hero-glow" aria-hidden="true"></div>

      <div class="page-wrap hero-layout">
        <div>
          <div class="eyebrow">
            <span aria-hidden="true"></span>
            FIRST-WIN DEMO / FIVE MINUTES
          </div>

          <h1>Can a fresh agent pick up work it did not start?</h1>

          <p class="hero-lede">
            Run one tiny, deliberately broken project through two fresh conversations. The second agent gets no transcript or prose handoff. It must recover the task, rationale, changed file, and next action from project state before it edits source.
          </p>

          <div class="hero-actions">
            <a href="#prepare" class="primary-action">
              Start the demo
              <Icon name="chevron-right" size="17" />
            </a>
            <a
              href="https://github.com/os-tack/ostk.ai/tree/main/demo/first-win"
              class="secondary-action"
            >
              Future canonical tree
            </a>
          </div>

          <p class="publication-note">
            The <code>demo/first-win</code> path is the canonical destination, but it may not be published on the <code>main</code> branch yet. If you have the current source checkout, use the local demo there.
          </p>
        </div>

        <aside class="run-contract" aria-label="First-win run contract">
          <div class="contract-topline">
            <span>RUN CONTRACT</span>
            <span class="ready-state"><i></i> BOUNDED TEST</span>
          </div>

          <div class="contract-question">
            <span>FRESH SESSION</span>
            <strong>“What am I walking into?”</strong>
          </div>

          <div class="contract-metrics">
            <div>
              <strong>05</strong>
              <span>minutes</span>
            </div>
            <div>
              <strong>02</strong>
              <span>fresh sessions</span>
            </div>
            <div>
              <strong>01</strong>
              <span>provider required</span>
            </div>
            <div>
              <strong>04</strong>
              <span>facts checked</span>
            </div>
          </div>

          <div class="contract-foot">
            <span>No transcript copy</span>
            <span>Disposable repository</span>
            <span>Machine-readable result</span>
          </div>
        </aside>
      </div>
    </section>

    <section class="page-wrap orientation-section">
      <div class="section-heading">
        <div>
          <div class="section-kicker">THE PASS CONDITION</div>
          <h2>Four facts, recovered before the fix.</h2>
        </div>
        <p>
          Agent B writes its orientation evidence before changing source or task state. The checker compares each answer with the live task, decision log, source diff, and recorded next action.
        </p>
      </div>

      <div class="check-grid">
        {orientationChecks.map((check) => (
          <article>
            <span>{check.number}</span>
            <h3>{check.label}</h3>
            <p>{check.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="prepare" class="journey-section">
      <div class="page-wrap">
        <div class="journey-heading">
          <div class="section-kicker">RUN THE DEMO</div>
          <h2>One controlled handoff, step by step.</h2>
          <p>
            The preparation script keeps the exercise away from the <code>ostk.ai</code> trust-root repository. Every agent action happens inside a new temporary Git repository.
          </p>
        </div>

        <div class="prerequisites">
          <div>
            <span>REQUIRES</span>
            <strong>ostk 7.7.3 · Git · Python 3 · mktemp</strong>
          </div>
          <div>
            <span>AGENT CONNECTION</span>
            <strong>A harness with the ostk MCP tools exposed</strong>
          </div>
        </div>

        <div class="steps">
          <article class="step">
            <div class="step-marker">
              <span>01</span>
              <i aria-hidden="true"></i>
            </div>
            <div class="step-content">
              <div class="step-label">PREPARE AN ISOLATED REPOSITORY</div>
              <h3>Let the script create a clean place to work.</h3>
              <p>
                From the <code>demo/first-win</code> directory in your source checkout, run the preparation script:
              </p>

              <button
                type="button"
                class="command-block"
                data-copy="./scripts/prepare.sh"
                aria-label="Copy prepare command"
              >
                <span class="command-prompt">$</span>
                <code>./scripts/prepare.sh</code>
                <span class="copy-label">COPY</span>
              </button>

              <div class="step-note">
                <Icon name="shield" size="19" />
                <p>
                  The script creates a fresh repository under <code>{'${TMPDIR:-/tmp}'}</code>, commits the clean demo baseline, then runs the verified initialization and boot commands inside that temporary repository. It does not initialize <code>ostk.ai</code>.
                </p>
              </div>

              <p class="instruction">Keep the printed temporary path. Both sessions must open that exact repository.</p>
            </div>
          </article>

          <article class="step">
            <div class="step-marker">
              <span>02</span>
              <i aria-hidden="true"></i>
            </div>
            <div class="step-content">
              <div class="step-label">CONNECT YOUR CODING AGENT</div>
              <h3>Expose the project tools through the supported MCP surface.</h3>
              <p>
                In your harness's MCP configuration, set the server command to:
              </p>

              <button
                type="button"
                class="command-block command-short"
                data-copy="ostk connect"
                aria-label="Copy MCP bridge command"
              >
                <span class="command-prompt">$</span>
                <code>ostk connect</code>
                <span class="copy-label">COPY</span>
              </button>

              <p class="instruction">
                Confirm the harness exposes ostk <code>read</code>, <code>fs_ops</code>, <code>search</code>, and <code>bash</code>. If those tools are missing, stop rather than substituting native file-edit tools.
              </p>
            </div>
          </article>

          <article class="step">
            <div class="step-marker">
              <span>03</span>
              <i aria-hidden="true"></i>
            </div>
            <div class="step-content">
              <div class="step-label">SESSION A / LEAVE REAL WORK IN FLIGHT</div>
              <h3>Give the first fresh session its bounded instructions.</h3>
              <p>
                Open your connected coding agent in the printed temporary repository and give it:
              </p>

              <div class="file-card">
                <Icon name="file-text" size="20" />
                <code>.first-win/prompts/agent-a.md</code>
              </div>

              <p class="instruction">
                Agent A verifies the failing tests, opens one task, records one decision, makes a deliberate partial edit, records the exact next action, and checks the handoff stage. It must leave the actual fix unfinished.
              </p>
            </div>
          </article>

          <article class="step proof-choice-step">
            <div class="step-marker">
              <span>04</span>
              <i aria-hidden="true"></i>
            </div>
            <div class="step-content">
              <div class="step-label">END THE CONVERSATION</div>
              <h3>Choose how strong you want the handoff test to be.</h3>
              <p>
                End Session A completely. Do not pass its transcript, generated summary, or a prose handoff into the next conversation.
              </p>

              <div class="proof-choice">
                <article class="choice-primary">
                  <div class="choice-badge">DEFAULT / ONE PROVIDER</div>
                  <h4>Same coding agent, fresh conversation</h4>
                  <p>
                    Start a genuinely new conversation in the same connected harness. This is the lowest-friction recovery test and requires only one provider account.
                  </p>
                  <span>Proves bounded cross-session recovery</span>
                </article>

                <article>
                  <div class="choice-badge">STRONGER / OPTIONAL</div>
                  <h4>Different connected harness</h4>
                  <p>
                    Open a fresh session in another supported harness against the same temporary repository. Do not give it anything from Session A.
                  </p>
                  <span>Adds cross-harness continuity evidence</span>
                </article>
              </div>

              <p class="instruction">
                If your harness injects its own persistent project memory into new conversations, the same-agent path is less isolated. The checker cannot distinguish that context from ostk-provided orientation.
              </p>
            </div>
          </article>

          <article class="step">
            <div class="step-marker">
              <span>05</span>
              <i aria-hidden="true"></i>
            </div>
            <div class="step-content">
              <div class="step-label">SESSION B / COLD ORIENTATION</div>
              <h3>Ask the question, then let the new agent inspect live state.</h3>

              <div class="prompt-card">
                <span>YOU</span>
                <strong>What am I walking into?</strong>
              </div>

              <p>
                Give the fresh session the bounded Agent B instructions:
              </p>

              <div class="file-card">
                <Icon name="file-text" size="20" />
                <code>.first-win/prompts/agent-b.md</code>
              </div>

              <p class="instruction">
                Before it edits source, Agent B must write the four facts to <code>evidence/agent-b-orientation.json</code>. Its prompt runs the orientation checker and proceeds only when the result reports <code>"ok": true</code>.
              </p>

              <div class="fact-strip">
                {orientationChecks.map((check) => (
                  <div>
                    <span>{check.number}</span>
                    <strong>{check.label}</strong>
                  </div>
                ))}
              </div>
            </div>
          </article>

          <article class="step">
            <div class="step-marker">
              <span>06</span>
            </div>
            <div class="step-content">
              <div class="step-label">COMPLETE AND CAPTURE THE RESULT</div>
              <h3>Let Agent B finish, then save the machine-readable evidence.</h3>
              <p>
                Agent B completes the recorded next action, runs the task's acceptance command, and closes the task only after it passes. To capture the final checker result:
              </p>

              <button
                type="button"
                class="command-block"
                data-copy="python3 .first-win/check.py --stage complete --json > evidence/acceptance.json"
                aria-label="Copy final checker command"
              >
                <span class="command-prompt">$</span>
                <code>python3 .first-win/check.py --stage complete --json &gt; evidence/acceptance.json</code>
                <span class="copy-label">COPY</span>
              </button>

              <div class="result-card">
                <div class="result-topline">
                  <span class="ready-state"><i></i> ACCEPTANCE EVIDENCE</span>
                  <code>evidence/acceptance.json</code>
                </div>
                <ul>
                  <li>The code tests pass.</li>
                  <li>The task closes only after its recorded acceptance condition passes.</li>
                  <li>Agent B's four-fact orientation was recorded before its source edit.</li>
                  <li>Required journal rows contain signature and previous-hash fields.</li>
                </ul>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="page-wrap boundaries-section">
      <div class="section-heading">
        <div>
          <div class="section-kicker">READ THE RESULT HONESTLY</div>
          <h2>What this demo does—and does not—establish.</h2>
        </div>
        <p>
          The output is useful evidence because the scenario is deterministic and the checks are machine-readable. Its scope is intentionally narrow.
        </p>
      </div>

      <div class="boundary-grid">
        <article class="establishes">
          <div class="boundary-label">ESTABLISHES</div>
          <h3>Project-state continuity across a cold conversation boundary.</h3>
          <ul>
            <li><Icon name="verified" size="17" /> Task, decision, and journal exist as ordinary files under <code>.ostk/</code>.</li>
            <li><Icon name="verified" size="17" /> Agent A leaves a specific failing source state and exact next action.</li>
            <li><Icon name="verified" size="17" /> Agent B records all four orientation facts before completing the task.</li>
            <li><Icon name="verified" size="17" /> The final acceptance condition gates task closure.</li>
          </ul>
        </article>

        <article class="limits">
          <div class="boundary-label">DOES NOT ESTABLISH</div>
          <h3>Universal provider, router, identity, or privacy claims.</h3>
          <ul>
            {limitations.map((item) => (
              <li><span aria-hidden="true">—</span>{item}</li>
            ))}
          </ul>
        </article>
      </div>

      <div class="data-boundary">
        <Icon name="alert-triangle" size="20" />
        <div>
          <strong>Provider data path</strong>
          <p>
            Canonical task, decision, and journal state is stored in the temporary project. That does not make every integration offline: configured providers may receive prompts or context, and anchored Anthropic sessions can use Anthropic Files. Review the integration's data path before using private code.
          </p>
        </div>
      </div>
    </section>

    <section class="cleanup-section">
      <div class="page-wrap cleanup-layout">
        <div>
          <div class="section-kicker">CLEAN UP</div>
          <h2>Close the kernel, keep or discard the evidence.</h2>
          <p>
            From the temporary demo repository, terminate the running kernel cleanly:
          </p>

          <button
            type="button"
            class="command-block command-short"
            data-copy="ostk shutdown"
            aria-label="Copy shutdown command"
          >
            <span class="command-prompt">$</span>
            <code>ostk shutdown</code>
            <span class="copy-label">COPY</span>
          </button>

          <p class="cleanup-note">
            Then delete the printed temporary directory when you no longer need its evidence. Cleanup is intentionally manual; the demo does not remove the repository for you.
          </p>
        </div>

        <aside>
          <span>WHAT REMAINS</span>
          <div>
            <strong>Acceptance evidence</strong>
            <code>evidence/acceptance.json</code>
          </div>
          <div>
            <strong>Orientation evidence</strong>
            <code>evidence/agent-b-orientation.json</code>
          </div>
          <div>
            <strong>Project trace</strong>
            <code>.ostk/</code>
          </div>
        </aside>
      </div>
    </section>

    <section class="page-wrap next-section">
      <div class="section-heading">
        <div>
          <div class="section-kicker">AFTER THE FIRST WIN</div>
          <h2>Choose the next useful boundary.</h2>
        </div>
        <p>
          Activation starts with a user outcome. Component details belong in the docs and “How it works,” once you need them.
        </p>
      </div>

      <div class="next-grid">
        {nextPaths.map((path) => (
          <a href={path.href}>
            <Icon name={path.icon} size="23" />
            <h3>{path.title}</h3>
            <p>{path.body}</p>
            <span>{path.action} <Icon name="chevron-right" size="15" /></span>
          </a>
        ))}
      </div>

      <div class="docs-link">
        <p>Looking for commands, configuration, or internal component references?</p>
        <a href="/docs/">Open the documentation <Icon name="chevron-right" size="15" /></a>
      </div>
    </section>
  </main>
</Base>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  .start-page {
    overflow: hidden;
    color: #e7e1de;
    background: #151311;
  }

  .page-wrap {
    width: min(100%, 1120px);
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  .start-hero {
    position: relative;
    overflow: hidden;
    padding: 9rem 0 7rem;
    isolation: isolate;
    border-bottom: 1px solid rgba(255, 193, 105, 0.16);
    background:
      radial-gradient(circle at 80% 22%, rgba(229, 164, 67, 0.13), transparent 28rem),
      linear-gradient(112deg, rgba(16, 14, 12, 0.98), rgba(33, 25, 16, 0.88));
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    z-index: -2;
    background-image:
      linear-gradient(rgba(255, 193, 105, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 193, 105, 0.04) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: linear-gradient(to bottom, black 10%, transparent 96%);
  }

  .hero-glow {
    position: absolute;
    z-index: -1;
    width: 30rem;
    height: 30rem;
    right: 8%;
    top: 13%;
    border-radius: 999px;
    background: rgba(229, 164, 67, 0.18);
    filter: blur(100px);
  }

  .hero-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(380px, 0.92fr);
    align-items: center;
    gap: clamp(3rem, 8vw, 8rem);
  }

  .eyebrow,
  .section-kicker,
  .step-label,
  .boundary-label {
    color: #ffc169;
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .eyebrow > span {
    width: 2.5rem;
    height: 1px;
    background: #ffc169;
    box-shadow: 0 0 10px rgba(255, 193, 105, 0.7);
  }

  .start-hero h1 {
    max-width: 720px;
    margin-top: 2rem;
    color: #f3ece7;
    font-family: 'Newsreader', serif;
    font-size: clamp(3.75rem, 7.2vw, 6.8rem);
    font-weight: 520;
    letter-spacing: -0.06em;
    line-height: 0.92;
    text-wrap: balance;
  }

  .hero-lede {
    max-width: 680px;
    margin-top: 1.7rem;
    color: #d5c4b1;
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    line-height: 1.75;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .primary-action,
  .secondary-action {
    display: inline-flex;
    min-height: 3.2rem;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 0.85rem 1.2rem;
    border: 1px solid transparent;
    font-size: 0.84rem;
    font-weight: 650;
    transition: transform 160ms ease, border-color 160ms ease, background 160ms ease;
  }

  .primary-action {
    color: #291800;
    background: #ffc169;
  }

  .secondary-action {
    color: #ffc169;
    border-color: rgba(255, 193, 105, 0.3);
    background: rgba(16, 14, 12, 0.6);
  }

  .primary-action:hover,
  .secondary-action:hover {
    transform: translateY(-2px);
  }

  .secondary-action:hover {
    border-color: #ffc169;
  }

  .publication-note {
    max-width: 680px;
    margin-top: 1.2rem;
    color: #9e8e7d;
    font-size: 0.72rem;
    line-height: 1.6;
  }

  code {
    color: #ffddb4;
    font-family: 'Space Grotesk', monospace;
  }

  .run-contract {
    border: 1px solid rgba(255, 193, 105, 0.3);
    background:
      linear-gradient(145deg, rgba(44, 41, 39, 0.9), rgba(16, 14, 12, 0.94));
    box-shadow: 0 36px 90px rgba(0, 0, 0, 0.4);
  }

  .contract-topline,
  .result-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1rem;
    color: #9e8e7d;
    border-bottom: 1px solid rgba(81, 69, 54, 0.7);
    font-size: 0.62rem;
    letter-spacing: 0.11em;
  }

  .ready-state {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: #c2c9b4;
  }

  .ready-state i {
    width: 0.43rem;
    height: 0.43rem;
    border-radius: 999px;
    background: #c2c9b4;
    box-shadow: 0 0 9px rgba(194, 201, 180, 0.65);
  }

  .contract-question {
    padding: 2.2rem 1.5rem;
    border-bottom: 1px solid rgba(81, 69, 54, 0.7);
    background: rgba(255, 193, 105, 0.055);
  }

  .contract-question span {
    display: block;
    color: #9e8e7d;
    font-size: 0.62rem;
    letter-spacing: 0.12em;
  }

  .contract-question strong {
    display: block;
    margin-top: 0.65rem;
    color: #ffddb4;
    font-family: 'Newsreader', serif;
    font-size: clamp(1.6rem, 2.8vw, 2.25rem);
    font-style: italic;
    font-weight: 440;
  }

  .contract-metrics {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: rgba(81, 69, 54, 0.65);
  }

  .contract-metrics div {
    padding: 1.2rem;
    background: #1d1b19;
  }

  .contract-metrics strong {
    display: block;
    color: #ffc169;
    font-family: 'Newsreader', serif;
    font-size: 2.1rem;
    font-style: italic;
    font-weight: 480;
  }

  .contract-metrics span {
    display: block;
    margin-top: 0.2rem;
    color: #9e8e7d;
    font-size: 0.66rem;
  }

  .contract-foot {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1rem;
    padding: 1rem;
    color: #9e8e7d;
    font-size: 0.62rem;
  }

  .contract-foot span + span::before {
    content: '·';
    margin-right: 1rem;
    color: #514536;
  }

  .orientation-section,
  .boundaries-section,
  .next-section {
    padding-block: clamp(6rem, 10vw, 9rem);
  }

  .section-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(280px, 0.82fr);
    align-items: end;
    gap: clamp(2.5rem, 8vw, 8rem);
  }

  .section-heading h2,
  .journey-heading h2,
  .cleanup-layout h2 {
    color: #f3ece7;
    font-family: 'Newsreader', serif;
    font-size: clamp(2.7rem, 5.2vw, 5rem);
    font-weight: 510;
    letter-spacing: -0.045em;
    line-height: 0.98;
    text-wrap: balance;
  }

  .section-kicker {
    margin-bottom: 1rem;
  }

  .section-heading > p,
  .journey-heading > p {
    color: #d5c4b1;
    font-size: 0.96rem;
    line-height: 1.75;
  }

  .check-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    margin-top: 4rem;
    background: rgba(81, 69, 54, 0.6);
    border: 1px solid rgba(81, 69, 54, 0.6);
  }

  .check-grid article {
