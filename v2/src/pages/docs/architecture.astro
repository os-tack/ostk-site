            <div class="flex justify-between"><span class="text-outline uppercase text-[10px]">JUDGMENT</span><span class="text-on-surface">{cpu.judgment}</span></div>
            <div class="flex justify-between"><span class="text-outline uppercase text-[10px]">RING</span><span class="text-primary font-mono">{cpu.ring}</span></div>
          </div>
        </div>
      ))}
