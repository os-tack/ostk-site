---
import DocsLayout from '../../layouts/DocsLayout.astro';
import Icon from '../../components/Icon.astro';
import Terminal from '../../components/Terminal.astro';
import { LATEST_TAG } from '../../site-version';

const humanFileDirectives = [
  { name: 'IDENTITY', req: true, desc: 'Your username. Used in audit attribution and agent identity.' },
  { name: 'SIGN', req: false, desc: 'Ed25519 multikey or legacy GPG fingerprint used as operator identity evidence. Tier depends on verification and anchor admission.' },
  { name: 'MODEL', req: true, desc: 'Default model for agent sessions. Kernel auto-detects provider from model name.' },
  { name: 'FALLBACK', req: false, desc: 'Model when primary is unavailable or rate-limited.' },
  { name: 'AVAILABLE <<MODELS', req: false, desc: 'Heredoc listing all authorized models. Consumed by FROM auto in Agentfiles.' },
  { name: 'SECRET <<KEYS', req: false, desc: 'Heredoc listing authorized API key names. Keys stored in platform keychain.' },
  { name: 'DRIVER <type> <name>', req: false, desc: 'FCP driver to load at boot. Internal drivers don\'t need declaration.' },
  { name: 'EMBED', req: false, desc: 'Embedding index mode: codebase (full), incremental (git-diff), off.' },
  { name: 'PREPROCESS', req: false, desc: 'Local model for preprocessing user input via olleh runtime. e.g. apple/default. Fixes grammar, expands tack shorthand before the remote LLM sees it.' },
  { name: 'TRUST', req: false, desc: 'Trust policy for Agentfile signing. unsigned skips signature requirement.' },
  { name: 'EXTENDS', req: false, desc: 'Path to parent HUMANFILE for inheritance. Child directives override.' },
  { name: 'BOOT', req: false, desc: 'Custom boot steps appended after kernel initialization.' },
  { name: 'VERB', req: false, desc: 'Custom verb registration merged into .language at boot.' },
];

const entityFileTiers = [
  { tier: 'T0', who: 'Verified project or operator root', caps: 'No tier-default restrictions; full governance', proof: 'Verified primefile or trusted Ed25519/DSSE evidence; legacy GPG anchor' },
  { tier: 'T1', who: 'T0-endorsed identity', caps: 'Source writes with kernel-state and governance restrictions', proof: 'Verified delegated evidence or legacy T0 cross-signature' },
  { tier: 'T2', who: 'Identity without T0 endorsement', caps: 'Governed src/, kernel state, and governance writes denied by default', proof: 'Recognized identity evidence without trusted endorsement' },
  { tier: 'T3', who: 'Anonymous', caps: 'Kernel-mediated writes denied by default', proof: 'No verified primefile or other recognized identity evidence' },
];

const primeFileFields = [
  { field: 'KERNEL', desc: 'Kernel identity name. Default: @project.prime.' },
  { field: 'VERSION', desc: 'Kernel declaration version.' },
  { field: 'AUTHORITY', desc: 'Who controls the kernel — primary (human), kernel, and co-signer requirements.' },
  { field: 'KEYS', desc: 'Trust-key registry, including Ed25519 multikeys and any legacy GPG anchors or cross-signature metadata.' },
  { field: 'LINEAGE', desc: 'Root of trust chain, co-signers, and chain continuity date.' },
];

const ostkTolmlSections = [
  { section: '[project]', desc: 'Project name and optional bail lineage (the upstream signed package this project was seeded from). Top-level kernel = ">=X.Y.Z" pin sits alongside.' },
  { section: '[authorization]', desc: 'Declarative trust policy: github_gpg_required, trust_tiers list. Documentary — source of truth is src/kernel/identity.rs trust anchors.' },
  { section: '[distribution]', desc: 'Release mirrors, signature verification, tarball pattern. Used by install scripts and bail fetchers, not the runtime kernel.' },
  { section: '[kernel]', desc: 'boot_mode (embedded-first | daemon-first), daemon_lifecycle, laws. The laws array is documentary — the actual five laws are enforced in code.' },
  { section: '[onboarding]', desc: 'install.sh ceremony steps. Documentary — consumed by the install script, not the kernel.' },
  { section: '[pins.*]', desc: 'Named pin configurations. read/write/execute paths and deny tokens. Parsed by the pin loader at boot.' },
  { section: '[features]', desc: 'Boolean toggles: tui, agents, audit, digest, embeddings. Read at boot to gate subsystem initialization.' },
  { section: '[mcp.*]', desc: 'Historical. MCP servers are declared in HUMANFILE, not ostk.toml — see /docs/mcp for the real path.' },
];

const envVarGroups = [
  {
    label: 'AGENT_IDENTITY',
    vars: [
      { name: 'OSTK_AGENT', desc: 'Agent alias. Set by kernel on spawn. Used for audit attribution, heartbeat, gen_table writer.', default_: '"unknown"' },
      { name: 'OSTK_PIN', desc: 'Active capability pin name. Loads .ostk/pins/<name>/pin.caps.', default_: 'Tier default' },
      { name: 'OSTK_TRUST_TIER', desc: 'Trusted test-harness override. It is intentionally ignored in normal untrusted agent processes and cannot grant production tier.', default_: 'Ignored unless the process explicitly enables the trusted test path' },
      { name: 'OSTK_AGENTFILE', desc: 'Path to Agentfile to load at boot.', default_: 'None' },
    ],
  },
  {
    label: 'DAEMON_SCHEDULER',
    vars: [
      { name: 'OSTK_SCHEDULER_TICK_SECONDS', desc: 'Scheduler tick loop interval. Set to 0 to disable.', default_: 'Disabled' },
      { name: 'OSTK_SCHEDULER_STUCK_AFTER_SECS', desc: 'Seconds before tick escalates from skipped to stuck in audit.', default_: '90' },
      { name: 'OSTK_SCHEDULER_FORCE_CLEAR_AFTER_SECS', desc: 'Seconds before force-clearing busy flag.', default_: '300' },
    ],
  },
  {
    label: 'DRAIN_RECOVERY',
    vars: [
      { name: 'OSTK_DRAIN_SNAPSHOT', desc: 'Controls drain snapshot writes. Set to 0 to disable.', default_: `Enabled (${LATEST_TAG}+)` },
    ],
  },
  {
    label: 'MODEL_SECRETS',
    vars: [
      { name: 'OSTK_MODEL', desc: 'Override default model for ostk run, ostk tack --run, FROM auto. Overrides HUMANFILE.', default_: 'HUMANFILE' },
      { name: 'OSTK_SECRET_CMD', desc: 'BYO vault command (ambient env variable is ignored for execution bounds in favor of local secret_cmd in .ostk/config).', default_: 'None' },
    ],
  },
  {
    label: 'DIAGNOSTICS',
    vars: [
      { name: 'OSTK_DUMP_REQUEST', desc: 'Directory for full API request JSON dumps. For debugging cache/preload.', default_: 'Disabled' },
      { name: 'OSTK_DUMP_HANDSHAKE', desc: 'File path for handshake bytes at boot. For debugging byte-stability.', default_: 'Disabled' },
      { name: 'OSTK_NO_CACHE', desc: 'Set to 1 to disable cache_control breakpoints.', default_: 'Disabled' },
      { name: 'OSTK_T2_OBSERVER', desc: 'Set to 1 for Hot PR Tier 2 arbitration audit rows.', default_: 'Disabled' },
    ],
  },
  {
    label: 'SYSTEM',
    vars: [
      { name: 'OSTK_STATE_DIR', desc: 'Override state directory name (instead of .ostk).', default_: '.ostk' },
      { name: 'OSTK_DIR', desc: 'Absolute path to .ostk directory. Set by kernel for FCP driver subprocesses.', default_: 'Auto' },
      { name: 'OSTK_REGISTRY_DIR', desc: 'Override global registry directory. Used by CI for isolation.', default_: '~/.ostk/' },
      { name: 'OSTK_PREPROCESS', desc: 'Local model for input preprocessing via olleh runtime. Overrides HUMANFILE PREPROCESS.', default_: 'HUMANFILE' },
      { name: 'OSTK_TOOL_THRESHOLD', desc: 'Momentum threshold for verb loading from .language. Float 0-1.', default_: '0.45' },
    ],
  },
];
---

<DocsLayout
  title="Configuration & Environment"
  description="Comprehensive reference for ostk configuration files (HUMANFILE, ENTITYFILE, .primefile, ostk.toml) and runtime environment variables."
  sectionLabel="CONFIGURATION // CONFIG_AND_ENV"
>
  <p class="font-headline text-lg text-on-surface-variant italic leading-relaxed max-w-xl mb-12">
    The configuration hierarchy governs identity, trust limits, project-specific settings, and ambient environment variable overrides.
  </p>

  <!-- Table of Contents -->
  <div class="bg-surface-container-low p-6 mb-16 border-l-2 border-primary max-w-2xl">
    <div class="font-label text-[10px] text-primary mb-3">CONFIGURATION_FILES</div>
    <ul class="space-y-2 font-body text-xs text-secondary">
      <li><a href="#humanfile" class="text-primary hover:underline">1. HUMANFILE</a> — Operator identity, defaults, and API keys</li>
      <li><a href="#entityfile" class="text-primary hover:underline">2. ENTITYFILE</a> — Governance constitution and authority chains</li>
      <li><a href="#primefile" class="text-primary hover:underline">3. .primefile</a> — Auto-generated kernel root-of-trust anchor</li>
      <li><a href="#ostktoml" class="text-primary hover:underline">4. ostk.toml</a> — Project-level config overrides</li>
      <li><a href="#envvars" class="text-primary hover:underline">5. Environment Variables</a> — Runtime flags and options</li>
    </ul>
  </div>

  <!-- Section 1: HUMANFILE -->
  <section id="humanfile" class="mb-24 pt-8 border-t border-surface-variant">
    <div class="flex items-center justify-between mb-4">
      <h2 class="serif-text text-3xl font-medium text-on-surface">1. HUMANFILE</h2>
      <span class="font-body text-xs text-outline">Location: <code>.ostk/HUMANFILE</code> or <code>~/.HUMANFILE</code></span>
    </div>
    
    <p class="font-body text-sm text-secondary max-w-xl mb-6">
      Your compiled operator identity. The OS reads this at boot and calibrates to you. This is a governance document representing the human at the terminal.
    </p>

    <div class="bg-surface-container-lowest p-6 border border-surface-variant mb-8">
      <div class="font-label text-[10px] text-outline mb-2">EXAMPLE_HUMANFILE</div>
      <pre class="font-body text-xs text-secondary leading-relaxed"><span class="text-primary">IDENTITY</span> yourname
<span class="text-primary">SIGN</span> &lt;verified-identity-evidence&gt;

<span class="text-primary">MODEL</span> claude-opus-4-6
<span class="text-primary">FALLBACK</span> mistral-large-latest

<span class="text-primary">AVAILABLE</span> &lt;&lt;MODELS
claude-sonnet-4-5
claude-opus-4-6
gemini-2.5-pro
mistral-large-latest
MODELS

<span class="text-primary">SECRET</span> &lt;&lt;KEYS
ANTHROPIC_API_KEY
GEMINI_API_KEY
KEYS

<span class="text-primary">DRIVER</span> rust fcp-rust
<span class="text-primary">EMBED</span> codebase
<span class="text-primary">PREPROCESS</span> apple/default</pre>
    </div>

    <div class="font-label text-[10px] text-primary mb-3">HUMANFILE_DIRECTIVES</div>
    <div class="bg-surface-container-low p-6 border-l-2 border-primary mb-8">
      <div class="space-y-0">
        {humanFileDirectives.map(d => (
          <div class="flex gap-6 text-xs font-body py-3 border-b border-surface-variant last:border-0">
            <code class="text-primary w-44 shrink-0">{d.name}</code>
            <span class={`w-8 shrink-0 ${d.req ? 'text-primary' : 'text-outline'}`}>
              {d.req ? 'REQ' : '—'}
            </span>
            <span class="text-secondary">{d.desc}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="font-label text-[10px] text-primary mb-3">SECRET_RESOLUTION_ORDER</div>
    <div class="space-y-3">
      {[
        { step: '01', label: 'BYO_SECRET_MANAGER', desc: 'secret_cmd inside .ostk/config (e.g. bw, op, pass). User-controlled local file only. Ambient environment variables like OSTK_SECRET_CMD are explicitly ignored to prevent injection/exfiltration.' },
        { step: '02', label: 'PLATFORM_KEYCHAIN', desc: 'macOS: security Keychain access. Linux: secret-tool storage.' },
        { step: '03', label: 'ENVIRONMENT_VARIABLE', desc: 'Fallback to $KEY in shell environment (least secure).' },
      ].map(s => (
        <div class="flex items-center gap-4 bg-surface-container p-4">
          <span class="serif-text text-xl font-bold text-primary">{s.step}</span>
          <div>
            <div class="font-body text-sm text-on-surface">{s.label}</div>
            <div class="font-body text-xs text-secondary mt-0.5">{s.desc}</div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Section 2: ENTITYFILE -->
  <section id="entityfile" class="mb-24 pt-8 border-t border-surface-variant">
    <div class="flex items-center justify-between mb-4">
      <h2 class="serif-text text-3xl font-medium text-on-surface">2. ENTITYFILE</h2>
      <span class="font-body text-xs text-outline">Location: <code>.ostk/ENTITYFILE</code></span>
    </div>

    <p class="font-body text-sm text-secondary max-w-xl mb-6">
      A project governance document for identity declarations, trust anchors, and structural policy. Effective permissions still come from the identity verifier, tier defaults, active pins, and the execution surface.
    </p>

    <div class="bg-surface-container grid grid-cols-1 md:grid-cols-12 mb-8">
      {entityFileTiers.map(t => (
        <div class="md:col-span-12 grid grid-cols-1 md:grid-cols-12 border-b border-surface-variant last:border-0">
          <div class="md:col-span-1 bg-surface-container-low flex items-center justify-center py-4">
            <span class="font-body text-lg font-bold text-primary">{t.tier}</span>
          </div>
          <div class="md:col-span-2 px-4 py-4">
            <span class="font-body text-xs text-on-surface font-medium">{t.who}</span>
          </div>
          <div class="md:col-span-6 px-4 py-4">
            <span class="font-body text-xs text-secondary leading-relaxed">{t.caps}</span>
          </div>
          <div class="md:col-span-3 px-4 py-4">
            <span class="font-body text-xs text-outline leading-relaxed">{t.proof}</span>
          </div>
        </div>
      ))}
    </div>

    <div class="bg-surface-container-lowest p-6 border border-surface-variant mb-8 max-w-2xl">
      <div class="font-label text-[10px] text-primary mb-2">CURRENT_IDENTITY_PATH</div>
      <p class="font-body text-xs text-secondary leading-relaxed mb-3">
        Current verification prefers supported Ed25519 and DSSE/OAE identity evidence. Detached <code class="text-primary">.asc</code> and Sigstore-era artifacts remain compatibility paths for projects that already use them; they are not the only way to establish a local root.
      </p>
      <p class="font-body text-xs text-outline leading-relaxed">
        Keep the document descriptive. Use <code class="text-primary">ostk boot</code> to see which evidence actually resolved and which default posture is active.
      </p>
    </div>

    <h3 class="serif-text text-xl font-medium text-on-surface mb-3">Changing Governance</h3>
    <div class="bg-surface-container-low p-6 border-l-2 border-primary mb-8 max-w-2xl">
      <p class="font-body text-xs text-secondary leading-relaxed mb-3">
        Governance writes routed through ostk are evaluated against the active identity posture and capability policy. Lower tiers are denied by default; a T0 operator can make an authorized change, while repository review and signature requirements remain explicit project policy.
      </p>
      <p class="font-body text-xs text-outline leading-relaxed">
        Identity evidence does not let an agent self-promote. Re-run <code class="text-primary">ostk boot</code> after a governance change to verify the evidence and resulting posture.
      </p>
    </div>
  </section>

  <!-- Section 3: .primefile -->
  <section id="primefile" class="mb-24 pt-8 border-t border-surface-variant">
    <div class="flex items-center justify-between mb-4">
      <h2 class="serif-text text-3xl font-medium text-on-surface">3. .primefile</h2>
      <span class="font-body text-xs text-outline">Location: <code>.ostk/.primefile</code></span>
    </div>

    <p class="font-body text-sm text-secondary max-w-xl mb-6">
      A project identity document created by <code class="text-primary">ostk init</code>. It records the local root and lineage evidence that boot can verify.
    </p>

    <div class="bg-surface-container-high p-6 border-t-4 border-primary mb-8 max-w-2xl">
      <p class="font-body text-sm text-on-surface mb-3">
        Treat <code class="text-primary">.primefile</code> as verified project identity evidence, not as a universal dual-GPG ceremony. Current projects can use Ed25519/DSSE-compatible evidence; legacy detached GPG material remains a fallback where present.
      </p>
      <p class="font-body text-xs text-secondary">
        Manual changes can invalidate the evidence. Use the supported initialization and governance paths, then confirm the resolved tier with <code class="text-primary">ostk boot</code>.
      </p>
    </div>

    <div class="font-label text-[10px] text-primary mb-3">PRIMEFILE_FIELDS</div>
    <div class="bg-surface-container-low p-6 border-l-2 border-primary mb-8">
      {primeFileFields.map(f => (
        <div class="flex gap-6 text-xs font-body py-3 border-b border-surface-variant last:border-0">
          <code class="text-primary w-28 shrink-0">{f.field}</code>
          <span class="text-secondary">{f.desc}</span>
        </div>
      ))}
    </div>

    <div class="font-label text-[10px] text-primary mb-3">VERIFY_THE_RESOLVED_EVIDENCE</div>
    <Terminal>
      <pre><span class="text-outline select-none">$ </span>ostk boot
<span class="text-outline"># Inspect the reported identity evidence, trust tier, and any degraded fallback.</span></pre>
    </Terminal>
    <p class="font-body text-xs text-secondary mt-3 max-w-lg">
      Boot reports the evidence path it can verify. Missing legacy GPG material alone does not imply T3 when verified primefile or other supported identity evidence is present.
    </p>
  </section>

  <!-- Section 4: ostk.toml -->
  <section id="ostktoml" class="mb-24 pt-8 border-t border-surface-variant">
    <div class="flex items-center justify-between mb-4">
      <h2 class="serif-text text-3xl font-medium text-on-surface">4. ostk.toml</h2>
      <span class="font-body text-xs text-outline">Location: <code>./ostk.toml</code></span>
    </div>

    <p class="font-body text-sm text-secondary max-w-xl mb-6">
      The project-level configuration file. Written and maintained by you at the repository root, it controls version bounds, pins, and custom tool rules.
    </p>

    <Terminal class="mb-8">
      <pre><span class="text-primary">[project]</span>
name = "ostk-site"
bail = "os-tack/ostk.ai"
kernel = ">=3.0.0, &lt;4.0.0"

<span class="text-outline"># Identity resolution comes from HUMANFILE SIGN evidence</span>
<span class="text-outline"># plus verified primefile evidence; see the trust reference.</span>

<span class="text-primary">[distribution]</span>
mirrors = [
  "https://github.com/os-tack/ostk.ai/releases",
  "https://ostk.ai/releases"
]
verify_signature = true
tarball_pattern = "ostk-{"{"}version{"}"}-{"{"}target{"}"}.tar.gz"

<span class="text-primary">[kernel]</span>
boot_mode = "embedded-first"
daemon_lifecycle = "tui-owned"
laws = ["familiar-project", "durable-state", "filesystem", "OCC", "inspectable-infra"]

<span class="text-primary">[onboarding]</span>
steps = ["binary-install", "environment-detect", "humanfile-create", "os-init", "import-offer"]

<span class="text-primary">[pins.default]</span>
read = [".ostk/", ".language"]
write = [".ostk/store/default/"]
execute = "shell(readonly)"
deny = ["write-kernel", "modify-governance"]

<span class="text-primary">[features]</span>
tui = true
agents = true
audit = true
digest = true
embeddings = false</pre>
    </Terminal>

    <div class="font-label text-[10px] text-primary mb-3">TOML_SECTIONS</div>
    <div class="space-y-px mb-8">
      {ostkTolmlSections.map(s => (
        <div class="bg-surface-container grid grid-cols-1 md:grid-cols-12">
          <div class="md:col-span-3 bg-surface-container-low px-4 py-3">
            <code class="font-body text-xs text-primary">{s.section}</code>
          </div>
          <div class="md:col-span-9 px-4 py-3">
            <span class="font-body text-xs text-secondary leading-relaxed">{s.desc}</span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Section 5: Environment Variables -->
  <section id="envvars" class="mb-24 pt-8 border-t border-surface-variant">
    <div class="flex items-center justify-between mb-4">
      <h2 class="serif-text text-3xl font-medium text-on-surface">5. Environment Variables</h2>
      <span class="font-body text-xs text-outline">Prefix: <code>OSTK_*</code></span>
    </div>

    <p class="font-body text-sm text-secondary max-w-xl mb-6">
      Ambient configuration options that live in the shell environment. Most are optional; the kernel boots cleanly with zero environment variables set.
    </p>

    {envVarGroups.map((group, i) => (
      <div class="mb-12">
        <div class="flex items-center gap-4 mb-4">
          <span class="serif-text text-xl font-bold text-primary">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="font-label text-xs uppercase tracking-widest text-primary">{group.label}</h3>
        </div>
        <div class="bg-surface-container-low p-6 border-l-2 border-primary">
          {group.vars.map(v => (
            <div class="flex gap-4 text-xs font-body py-3 border-b border-surface-variant last:border-0">
              <code class="text-primary w-72 shrink-0">{v.name}</code>
              <span class="text-secondary flex-1 leading-relaxed">{v.desc}</span>
              <span class="text-outline w-28 shrink-0 text-right">{v.default_}</span>
            </div>
          ))}
        </div>
      </div>
    ))}
  </section>

  <div class="metadata-ribbon border-t border-surface-variant">
    <span class="font-label text-[10px] text-secondary mr-4">RELATED:</span>
    <a href="/docs/agentfile/"><Icon name="smart_toy" size="14" class="align-middle mr-1" />AGENTFILE</a>
    <a href="/docs/security/"><Icon name="shield" size="14" class="align-middle mr-1" />SECURITY_AND_TRUST</a>
    <a href="/docs/architecture/"><Icon name="architecture" size="14" class="align-middle mr-1" />ARCHITECTURE</a>
  </div>
</DocsLayout>
