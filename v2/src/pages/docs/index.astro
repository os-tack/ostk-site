---
import DocsLayout from '../../layouts/DocsLayout.astro';
import Icon from '../../components/Icon.astro';
import { LATEST_TAG } from '../../site-version';

const sections = [
  {
    label: 'ONBOARDING',
    items: [
      { title: 'Quick Start', desc: 'Zero to running agents in 5 minutes', href: '/start/', icon: 'rocket_launch' },
      { title: 'Downloads', desc: 'Binary releases and install script', href: '/docs/downloads/', icon: 'download' },
      { title: 'Learn Sandbox', desc: 'Hands-on tutorial for first-time operators', href: '/docs/how-to/learn-sandbox/', icon: 'school' },
    ],
  },
  {
    label: 'MODULAR_STACK',
    items: [
      { title: 'ostk (Kernel)', desc: 'Optimistic concurrency daemon and terminal interface', href: '/docs/ostk/', icon: 'terminal' },
      { title: 'ostk-recall (Memory)', desc: 'Autonomous memory and context indexing MCP server', href: '/docs/ostk-recall/', icon: 'memory' },
      { title: 'ostk-cache (Proxy)', desc: 'Drop-in LLM proxy with multi-tier prompt compression', href: '/docs/ostk-cache/', icon: 'compress' },
      { title: 'libostk (Client)', desc: 'Userspace client library with JSON-RPC interface', href: '/docs/libostk/', icon: 'extension' },
    ],
  },
  {
    label: 'REFERENCE',
    items: [
      { title: 'Commands', desc: 'Full command reference', href: '/docs/commands/', icon: 'terminal' },
      { title: 'Architecture', desc: 'Foundational laws, substrate, and design principles', href: '/docs/architecture/', icon: 'architecture' },
      { title: 'Boot Sequence', desc: 'Kernel boot, daemon attach, POST checks', href: '/docs/boot-sequence/', icon: 'power_settings_new' },
      { title: 'Agent Lifecycle', desc: 'Daemon sessions and client multiplexing', href: '/docs/agent-lifecycle/', icon: 'sync' },
      { title: 'Context Management', desc: 'Prompt compression (Squasher), inline diagnostics, skills, and pull-model context', href: '/docs/context-management/', icon: 'layers' },
      { title: 'Coordination', desc: 'VFS overlay, optimistic concurrency, and conflict resolution', href: '/docs/coordination-primitives/', icon: 'merge' },
      { title: 'Sphere Navigator', desc: 'Spatial context navigation for agents', href: '/docs/sphere-navigator/', icon: 'explore' },
      { title: 'Tack Grammar', desc: 'The operator intent language for the TUI tack bar', href: '/docs/tack-grammar/', icon: 'code' },
      { title: 'Specifications', desc: 'Low-level kernel specifications, POSIX-shaped invariants, and application layer specs', href: '/docs/spec/', icon: 'description' },
    ],
  },
  {
    label: 'CONFIGURATION',
    items: [
      { title: 'Configuration Reference', desc: 'HUMANFILE, ENTITYFILE, .primefile, ostk.toml, and environment variables', href: '/docs/configuration/', icon: 'settings' },
      { title: 'Agentfile', desc: 'Agent process descriptor', href: '/docs/agentfile/', icon: 'smart_toy' },
    ],
  },
  {
    label: 'GOVERNANCE',
    items: [
      { title: 'Security & Trust', desc: 'T0-T3 trust tiers, capability pins, verifiable audits, secrets, and bail', href: '/docs/security/', icon: 'shield' },
      { title: 'FAQ', desc: 'Common questions from developers', href: '/docs/faq/', icon: 'help' },
    ],
  },
];
---

<DocsLayout
  title="Documentation Archive"
  seoTitle="ostk Documentation for AI Coding Agent Infrastructure"
  description="Learn ostk from first install through project state, agent handoffs, model routes, MCP, coordination, context management, security, and the System ABI."
  sectionLabel={`ARCHIVE_INDEX // ${LATEST_TAG}`}
>
  <p class="font-body text-sm text-secondary max-w-xl mb-12">
    Complete reference for the ostk kernel, daemon, drivers, and governance model.
  </p>

  {sections.map((section, i) => (
    <section class="mb-20">
      {/* Section header with tonal step */}
      <div class="bg-surface-container-low px-6 py-4 border-l-2 border-primary mb-8">
        <div class="flex items-center gap-4">
          <span class="font-headline text-2xl font-bold text-primary">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h2 class="font-label text-xs uppercase tracking-widest text-primary">{section.label}</h2>
            <p class="font-body text-[10px] text-secondary mt-0.5">
              {section.label === 'ONBOARDING' && 'Start here. Install, initialize, boot.'}
              {section.label === 'MODULAR_STACK' && 'Individual components of the ostk framework.'}
              {section.label === 'REFERENCE' && 'Kernel internals, commands, and protocol specifications.'}
              {section.label === 'CONFIGURATION' && 'Files that define identity, governance, and agent behavior.'}
              {section.label === 'GOVERNANCE' && 'Trust model and operational laws.'}
            </p>
          </div>
        </div>
      </div>

      {/* Card grid */}
      <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-surface-variant">
        {section.items.map(item => (
          <a href={item.href} class="bg-surface p-6 hover:bg-surface-container transition-none group block">
            <div class="flex items-start gap-4">
              <Icon name={item.icon} size="14" class="text-lg text-outline group-hover:text-primary mt-0.5" />
              <div>
                <div class="font-body text-sm text-on-surface group-hover:text-primary font-medium">{item.title}</div>
                <div class="font-body text-xs text-secondary mt-1.5 leading-relaxed">{item.desc}</div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>
  ))}
</DocsLayout>
