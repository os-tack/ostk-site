    margin-right: 1.25rem;
    color: #514536;
  }

  .project-map {
    position: relative;
    min-height: 640px;
    overflow: hidden;
    border: 1px solid rgba(255, 193, 105, 0.18);
    background:
      radial-gradient(circle at center, rgba(229, 164, 67, 0.12), transparent 45%),
      linear-gradient(145deg, rgba(44, 41, 39, 0.74), rgba(16, 14, 12, 0.86));
    box-shadow:
      0 45px 100px rgba(0, 0, 0, 0.42),
      inset 0 1px 0 rgba(255, 221, 180, 0.08);
