---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { LATEST_TAG } from '../site-version';

const painPoints = [
  {
    number: '01',
    title: 'Every fresh session starts too cold.',
    body: 'The task is still real, but its rationale, open questions, and next move are scattered across a chat the new agent cannot see.',
  },
  {
    number: '02',
    title: 'Tool choice becomes a trap.',
    body: 'A better model or a different coding agent is available, but switching means briefing it from scratch and hoping nothing important gets lost.',
  },
  {
    number: '03',
    title: 'Fast agents create invisible work.',
    body: 'More changes arrive faster, while decisions, handoffs, and conflicting edits become harder for a person or team to reconstruct.',
  },
];

const ownershipPoints = [
  {
    label: 'Custody',
    body: 'Canonical working state is kept with the project instead of belonging to one chat account.',
  },
  {
    label: 'Legibility',
    body: 'Tasks, decisions, and traces remain inspectable by people and supported agents.',
  },
  {
    label: 'Exit',
    body: 'Change the model, provider, router, or coding surface without abandoning the work already captured.',
  },
];

const goalPaths = [
  {
    number: '01',
    icon: 'terminal',
    eyebrow: 'I already use a coding agent',
    title: 'Carry the work into the next session.',
    body: 'Start with the tool you use today. Give a fresh supported agent the task, decisions, and next step without pasting the old chat.',
    href: '/start/',
    action: 'Start the handoff path',
  },
  {
    number: '02',
    icon: 'cpu',
    eyebrow: 'I want local or private inference',
    title: 'Change where the model runs, not how the project remembers.',
    body: 'Connect a configured local-model route while the durable working state remains with the same project.',
    href: '/start/local/',
    action: 'Start the local path',
  },
  {
    number: '03',
    icon: 'users',
    eyebrow: 'I am coordinating a team or CI',
    title: 'Give parallel agents a shared frame.',
    body: 'Surface in-flight work and conflicting writes so agents and people can coordinate without relying on one private conversation.',
    href: '/start/server/',
    action: 'Start the team path',
  },
];

const evidenceCards = [
  {
    label: 'Continuity',
    title: 'Repeat the handoff.',
    body: 'The first-win path has a visible pass condition: a new supported agent names the task, rationale, changed file, and next action.',
    href: '/start/',
    action: 'See the first win',
  },
  {
    label: 'Performance',
    title: 'Compare combinations, not slogans.',
    body: 'Needle Bench publishes model-and-harness outcomes separately. Results are provider-specific; there is no universal savings claim.',
    href: 'https://needle-bench.cc/',
    action: 'Open Needle Bench',
  },
  {
    label: 'Compatibility',
    title: 'Know what is supported.',
    body: 'Support is integration-specific. Check the model and endpoint matrix before treating portability as a product promise.',
    href: '/docs/models/',
    action: 'View supported models',
  },
];
---

<Base
  marketing
  title="Project State for AI Coding Agents — ostk"
  description="Open-source project state for AI coding agents. Keep tasks, decisions, working state, and audit with your code so supported agents can reorient across sessions."
>
  <script slot="schema" type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "https://ostk.ai/#organization",
        "name": "ostk",
        "url": "https://ostk.ai/",
        "description": "Open-source project infrastructure for AI coding agents.",
        "logo": {
          "@type": "ImageObject",
          "url": "https://ostk.ai/og-image.png",
          "width": 1200,
          "height": 630
        },
        "sameAs": ["https://github.com/os-tack"]
      },
      {
        "@type": "WebSite",
        "@id": "https://ostk.ai/#website",
        "url": "https://ostk.ai/",
        "name": "ostk",
        "alternateName": "ostk.ai",
        "inLanguage": "en",
        "publisher": { "@id": "https://ostk.ai/#organization" }
      },
      {
        "@type": "SoftwareApplication",
        "@id": "https://ostk.ai/#software",
        "name": "ostk",
        "applicationCategory": "DeveloperApplication",
        "operatingSystem": "macOS, Linux",
        "description": "Project state, coordination, and audit that remain available across supported AI coding agents.",
        "url": "https://ostk.ai/",
        "downloadUrl": "https://ostk.ai/install.sh",
        "softwareVersion": LATEST_TAG.replace(/^v/, ''),
        "license": "https://ostk.ai/legal/license/",
        "isAccessibleForFree": true,
        "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
        "publisher": { "@id": "https://ostk.ai/#organization" },
        "isPartOf": { "@id": "https://ostk.ai/#website" }
      }
    ]
  })} />

  <main id="main-content" class="landing flex-1">
    <section class="hero">
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="hero-glow hero-glow-one" aria-hidden="true"></div>
      <div class="hero-glow hero-glow-two" aria-hidden="true"></div>

      <div class="hero-inner">
        <div class="hero-copy">
          <div class="hero-eyebrow">
            <span class="eyebrow-mark" aria-hidden="true"></span>
            PROJECT STATE YOU OWN
          </div>

          <h1 class="display-title">
            Your agents change.<br />
            <span>Your work stays.</span>
          </h1>

          <p class="orientation-proof">A new agent can enter work it did not start.</p>

          <p class="hero-lede">
            Keep canonical tasks, decisions, and working state with the project—not dependent on one chat or provider. Continue in another supported coding agent without re-briefing it.
          </p>

          <div class="custody-proof">
            <Icon name="hard-drive" size="18" />
            <span>The model can change. Canonical project state remains yours.</span>
          </div>

          <div class="hero-actions">
            <a href="#handoff" class="button button-primary plausible-event-name=Handoff+Demo+View">
              See the 60-second handoff
              <Icon name="chevron-right" size="17" />
            </a>
            <a href="/start/" class="button button-secondary plausible-event-name=Start+Here plausible-event-source=hero">
              Try the first win
            </a>
          </div>

          <div class="hero-meta" aria-label="Product details">
            <span>{LATEST_TAG}</span>
            <span>Open source</span>
            <span>Integration-specific support</span>
          </div>
        </div>

        <div
          class="project-map"
          role="img"
          aria-label="A persistent project plane holding tasks, decisions, context, and audit while supported coding agents connect and disconnect"
        >
          <div class="map-grid" aria-hidden="true"></div>

          <svg class="connection-map" viewBox="0 0 680 620" preserveAspectRatio="none" aria-hidden="true">
            <path class="connection-line line-dim" d="M122 106 C180 162 220 187 284 237" />
            <path class="connection-line line-live" d="M558 115 C500 164 456 189 395 237" />
            <path class="connection-line line-dim" d="M118 520 C181 462 219 432 284 389" />
            <path class="connection-line line-dim" d="M560 514 C500 463 457 432 397 389" />
            <circle class="pulse-dot" r="5">
              <animateMotion dur="3.4s" repeatCount="indefinite" path="M558 115 C500 164 456 189 395 237" />
            </circle>
          </svg>

          <div class="endpoint endpoint-a">
            <div class="endpoint-head">
              <span class="status-dot status-idle"></span>
              <span>CODING AGENT 01</span>
            </div>
            <strong>Session complete</strong>
            <small>configured client</small>
          </div>

          <div class="endpoint endpoint-b">
            <div class="endpoint-head">
              <span class="status-dot status-live"></span>
              <span>CODING AGENT 02</span>
            </div>
            <strong>Entering project</strong>
            <small>configured client</small>
          </div>

          <div class="endpoint endpoint-c">
            <div class="endpoint-head">
              <span class="status-dot"></span>
              <span>CODING AGENT 03</span>
            </div>
            <strong>Available</strong>
            <small>configured client</small>
          </div>

          <div class="endpoint endpoint-d">
            <div class="endpoint-head">
              <span class="status-dot"></span>
              <span>INFERENCE ROUTE</span>
            </div>
            <strong>Available</strong>
            <small>configured route</small>
          </div>

          <div class="project-plane">
            <div class="plane-topline">
              <div>
                <span class="plane-kicker">PERSISTENT PROJECT PLANE</span>
                <h2>.ostk / project</h2>
              </div>
              <span class="plane-state"><i></i> state available</span>
            </div>

            <div class="state-ledger">
              <div>
                <span>TASK</span>
                <strong>Refine retry boundary</strong>
              </div>
              <div>
                <span>DECISION</span>
                <strong>Backoff stays at adapter</strong>
              </div>
              <div>
                <span>CHANGED</span>
                <strong>src/retry.rs</strong>
              </div>
              <div>
                <span>NEXT</span>
                <strong>Run focused tests</strong>
              </div>
            </div>

            <div class="incoming-prompt">
              <span>NEW AGENT</span>
              <p>“What am I walking into?”</p>
              <div class="prompt-response">
                <i aria-hidden="true"></i>
                <span>Context restored from project state</span>
              </div>
            </div>
          </div>

          <div class="map-caption">
            <span class="caption-line"></span>
            THE INTERFACE CHANGES. THE PROJECT PLANE PERSISTS.
          </div>
        </div>
      </div>
    </section>

    <section id="pain" class="section-wrap pain-section">
      <div class="section-heading split-heading">
        <div>
          <div class="section-kicker">THE BREAK IN TODAY'S WORKFLOW</div>
          <h2>The expensive part is not starting.<br />It is starting over.</h2>
        </div>
        <p>
          Coding agents can move quickly inside one session. The fracture appears between sessions, tools, people, and providers—exactly where project work needs to remain coherent.
        </p>
      </div>

      <div class="pain-grid">
        {painPoints.map((point) => (
          <article class="pain-card">
            <span class="card-number">{point.number}</span>
            <h3>{point.title}</h3>
            <p>{point.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="handoff" class="handoff-section">
      <div class="section-wrap">
        <div class="section-heading handoff-heading">
          <div class="section-kicker">THE 60-SECOND DEMO</div>
          <h2>A new agent can enter work it did not start.</h2>
          <p>
            This is the cold-orientation test: end one connected agent session, open a fresh session—optionally in another harness—and ask one question.
          </p>
        </div>

        <div class="handoff-stage">
          <div class="stage-topbar">
            <span>COLD SESSION HANDOFF</span>
            <span class="stage-status"><i></i> PROJECT STATE READY</span>
          </div>

          <div class="handoff-flow">
            <article class="flow-card flow-agent">
              <div class="flow-card-label">
                <span>00:00</span>
                <span>AGENT A</span>
              </div>
              <div class="agent-name">Connected agent A</div>
              <div class="flow-event">
                <span class="flow-event-dot"></span>
                Session exits with work in flight
              </div>
              <ul>
                <li>Task opened</li>
                <li>Decision recorded</li>
                <li>Partial edit present</li>
              </ul>
            </article>

            <div class="flow-arrow" aria-hidden="true">→</div>

            <article class="flow-card flow-project">
              <div class="flow-card-label">
                <span>00:24</span>
                <span>PROJECT</span>
              </div>
              <div class="project-core-icon">
                <Icon name="layers" size="26" />
              </div>
              <div class="agent-name">Working state persists</div>
              <p>Task, rationale, file generation, and next move remain available outside the first conversation.</p>
              <div class="state-chip-row">
                <span>task</span><span>decision</span><span>file</span><span>trace</span>
              </div>
            </article>

            <div class="flow-arrow" aria-hidden="true">→</div>

            <article class="flow-card flow-agent">
              <div class="flow-card-label">
                <span>00:60</span>
                <span>AGENT B</span>
              </div>
              <div class="agent-name">Fresh agent session</div>
              <div class="flow-event flow-event-live">
                <span class="flow-event-dot"></span>
                Fresh session enters
              </div>
              <div class="question-card">
                <span>YOU</span>
                <strong>What am I walking into?</strong>
              </div>
            </article>
          </div>

          <div class="orientation-result">
            <div class="result-label">
              <span class="status-dot status-live"></span>
              ORIENTATION RESULT
            </div>
            <div class="result-copy">
              <span>01 / TASK</span>
              <strong>Refine the retry boundary.</strong>
            </div>
            <div class="result-copy">
              <span>02 / WHY</span>
              <strong>Backoff belongs at the adapter.</strong>
            </div>
            <div class="result-copy">
              <span>03 / NEXT</span>
              <strong>Review src/retry.rs, then run the focused tests.</strong>
            </div>
          </div>

          <div class="stage-footnote">
            <span>No pasted transcript—a run condition.</span>
            <span>Second harness optional.</span>
            <span>One project-owned canonical state.</span>
          </div>
        </div>
      </div>
    </section>

    <section id="substrate" class="section-wrap substrate-section">
      <div class="substrate-intro">
        <div>
          <div class="section-kicker">WHAT MAKES THE HANDOFF POSSIBLE</div>
          <h2>Own your substrate.</h2>
        </div>
        <div>
          <p class="substrate-definition">
            The substrate is the durable project layer beneath the agent: working state, decisions, coordination, and trace. Agents can come and go; this layer remains under your control.
          </p>
          <a href="/why/" class="text-link">Why ownership matters <Icon name="chevron-right" size="15" /></a>
        </div>
      </div>

      <div class="is-isnt-grid">
        <article class="definition-card definition-positive">
          <div class="definition-label"><span>IS</span> PROJECT INFRASTRUCTURE</div>
          <h3>The part of agent work that should outlive a session.</h3>
          <ul>
            <li><Icon name="verified" size="17" /> Durable tasks and decisions</li>
            <li><Icon name="verified" size="17" /> Shared orientation for supported agents</li>
            <li><Icon name="verified" size="17" /> Inspectable coordination and trace</li>
          </ul>
        </article>

        <article class="definition-card">
          <div class="definition-label"><span>IS NOT</span> ANOTHER PLACE TO WORK</div>
          <h3>Not a model, router, chat interface, or cloud workspace.</h3>
          <p>
            ostk does not ask you to replace the coding surface you prefer. It sits below supported tools and keeps the project frame available between them.
          </p>
          <div class="not-list">
            <span>MODEL</span>
            <span>PROVIDER</span>
            <span>ROUTER</span>
            <span>HARNESS</span>
          </div>
        </article>
      </div>

      <div class="ownership-grid">
        {ownershipPoints.map((point, index) => (
          <article>
            <span>0{index + 1}</span>
            <h3>{point.label}</h3>
            <p>{point.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="paths" class="paths-section">
      <div class="section-wrap">
        <div class="section-heading split-heading">
          <div>
            <div class="section-kicker">START FROM YOUR ACTUAL GOAL</div>
            <h2>One product.<br />Three useful entrances.</h2>
          </div>
          <p>
            You should not need to understand the internal modules before getting value. Choose the failure you want to remove first.
          </p>
        </div>

        <div class="path-grid">
          {goalPaths.map((path) => (
            <a href={path.href} class="path-card">
              <div class="path-topline">
                <span>{path.number}</span>
                <Icon name={path.icon} size="21" />
              </div>
              <div class="path-eyebrow">{path.eyebrow}</div>
              <h3>{path.title}</h3>
              <p>{path.body}</p>
              <span class="path-action">{path.action} <Icon name="chevron-right" size="15" /></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section id="evidence" class="section-wrap evidence-section">
      <div class="section-heading evidence-heading">
        <div class="section-kicker">EVIDENCE BEFORE CLAIMS</div>
        <h2>Proof you can inspect, repeat, and compare.</h2>
        <p>
          Portability is a behavior, not a slogan. Each claim should resolve to a configured client, a repeatable handoff, or a published measurement.
        </p>
      </div>

      <div class="evidence-grid">
        {evidenceCards.map((card, index) => (
          <article class="evidence-card">
            <div class="evidence-index">0{index + 1}</div>
            <div>
              <div class="evidence-label">{card.label}</div>
              <h3>{card.title}</h3>
              <p>{card.body}</p>
              <a href={card.href} class="text-link">{card.action} <Icon name="chevron-right" size="15" /></a>
            </div>
          </article>
        ))}
      </div>

      <div class="before-install">
        <div class="before-install-heading">
          <span>BEFORE YOU INSTALL</span>
          <h3>The boundaries should be legible.</h3>
        </div>
        <dl>
          <div>
            <dt>What works?</dt>
            <dd>Support is integration-specific. The compatibility matrix names supported models and endpoints.</dd>
          </div>
          <div>
            <dt>Where is state?</dt>
            <dd>Canonical project state is kept with the project. Some continuity modes send conversation history or context to the configured provider; anchored Anthropic sessions can use Anthropic Files.</dd>
          </div>
          <div>
            <dt>What does it cost?</dt>
            <dd>Token, latency, and solve-rate effects vary by combination and are reported separately.</dd>
          </div>
          <div>
            <dt>Can I inspect it?</dt>
            <dd>The implementation, project artifacts, and operational trace remain available for review.</dd>
          </div>
        </dl>
      </div>
    </section>

    <section id="start" class="start-section">
      <div class="start-glow" aria-hidden="true"></div>
      <div class="section-wrap start-inner">
        <div>
          <div class="section-kicker">FIRST WIN</div>
          <h2>Keep the work.<br />Change the agent when you need to.</h2>
          <p>
            Start in an isolated project, complete the cold-orientation handoff, then bring the same durable frame to your own repository.
          </p>
          <div class="start-actions">
            <a href="/start/" class="button button-primary plausible-event-name=Start+Here plausible-event-source=footer-cta">
              Try the first-win path
              <Icon name="chevron-right" size="17" />
            </a>
            <a href="/docs/" class="button button-secondary">Read the field guide</a>
          </div>
        </div>

        <div class="install-panel">
          <div class="install-topline">
            <span>INSTALL OSTK</span>
            <span>{LATEST_TAG}</span>
          </div>
          <button
            type="button"
            data-copy="curl -fsSL https://ostk.ai/install.sh | sh"
            class="install-command plausible-event-name=Install+Copied plausible-event-source=landing-footer"
          >
            <span class="command-prompt">$</span>
            <code>curl -fsSL https://ostk.ai/install.sh | sh</code>
            <span class="copy-label">COPY</span>
          </button>
          <p>Review compatibility and the per-integration data path above before installing on macOS or Linux.</p>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }

  .landing {
    overflow: hidden;
    background:
      radial-gradient(circle at 83% 6%, rgba(229, 164, 67, 0.07), transparent 24rem),
      #151311;
  }

  .hero {
    position: relative;
    min-height: min(980px, 100vh);
    padding: 8.5rem 1.5rem 6rem;
    isolation: isolate;
    border-bottom: 1px solid rgba(255, 193, 105, 0.13);
    background:
      linear-gradient(105deg, rgba(16, 14, 12, 0.96) 0%, rgba(21, 19, 17, 0.9) 48%, rgba(31, 24, 16, 0.72) 100%);
  }

  .hero-grid,
  .map-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(255, 193, 105, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 193, 105, 0.045) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: linear-gradient(to bottom, black 15%, transparent 92%);
  }

  .hero-grid::after,
  .map-grid::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255, 221, 180, 0.12) 0.6px, transparent 0.6px);
    background-size: 5px 5px;
    opacity: 0.18;
  }

  .hero-glow,
  .start-glow {
    position: absolute;
    pointer-events: none;
    border-radius: 999px;
    filter: blur(90px);
    opacity: 0.24;
  }

  .hero-glow-one {
    width: 34rem;
    height: 34rem;
    right: 7%;
    top: 15%;
    background: rgba(229, 164, 67, 0.25);
  }

  .hero-glow-two {
    width: 18rem;
    height: 18rem;
    left: 35%;
    bottom: 5%;
    background: rgba(194, 201, 180, 0.11);
  }

  .hero-inner,
  .section-wrap {
    width: min(100%, 1280px);
    margin-inline: auto;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(540px, 1.1fr);
    align-items: center;
    gap: clamp(3rem, 6vw, 7rem);
  }

  .hero-copy {
    padding-block: 2rem;
  }

  .hero-eyebrow,
  .section-kicker {
    color: #ffc169;
    font-family: 'Space Grotesk', monospace;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .eyebrow-mark {
    width: 2.75rem;
    height: 1px;
    background: #ffc169;
    box-shadow: 0 0 12px rgba(255, 193, 105, 0.8);
  }

  .display-title {
    max-width: 760px;
    color: #f3ece7;
    font-family: 'Newsreader', serif;
    font-size: clamp(4.15rem, 7.3vw, 7.4rem);
    font-weight: 560;
    letter-spacing: -0.066em;
    line-height: 0.86;
    text-wrap: balance;
  }

  .display-title span {
    color: #ffc169;
    font-style: italic;
    font-weight: 430;
    text-shadow: 0 0 46px rgba(229, 164, 67, 0.18);
  }

  .orientation-proof {
    margin-top: 2.1rem;
    max-width: 620px;
    color: #e7e1de;
    font-family: 'Newsreader', serif;
    font-size: clamp(1.45rem, 2.1vw, 2rem);
    line-height: 1.18;
  }

  .hero-lede {
    max-width: 640px;
    margin-top: 1.25rem;
    color: #d5c4b1;
    font-size: clamp(1rem, 1.3vw, 1.18rem);
    line-height: 1.72;
  }

  .custody-proof {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: fit-content;
    margin-top: 1.8rem;
    padding: 0.8rem 1rem;
    color: #e7e1de;
    border: 1px solid rgba(255, 193, 105, 0.25);
    background: rgba(255, 193, 105, 0.07);
    font-size: 0.88rem;
  }

  .custody-proof :global(svg) {
    flex: 0 0 auto;
    color: #ffc169;
  }

  .hero-actions,
  .start-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .button {
    display: inline-flex;
    min-height: 3.25rem;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
