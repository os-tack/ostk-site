---
import Base from '../layouts/Base.astro';
import Sidebar from '../components/Sidebar.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { LATEST_TAG, LATEST_VERSION, RELEASE_URL } from '../site-version';

const sidebarGroups = {
  sections: [
    {
      label: 'ABOUT_OSTK',
      items: [
        { icon: 'help_outline', label: 'WHY_OSTK', href: '/why/' },
        { icon: 'layers', label: 'THE_STACK', href: '/stack/' },
        { icon: 'rocket_launch', label: 'START_HERE', href: '/start/' },
      ],
    },
    {
      label: 'LINEAGE_AND_GOVERNANCE',
      items: [
        { icon: 'auto_stories', label: 'DOCTRINE', href: '/doctrine/' },
        { icon: 'gavel', label: 'GOVERNANCE', href: '/governance/' },
        { icon: 'info', label: 'ABOUT', href: '/about/' },
        { icon: 'history', label: 'CHANGELOG', href: '/changelog/' },
      ],
    },
  ],
  bottomItems: [
    { icon: 'menu_book', label: 'ALL_DOCS', href: '/docs/' },
    { icon: 'code', label: 'SOURCE', href: 'https://github.com/os-tack/ostk.ai' },
  ],
};

// Hand-maintained release log. LATEST_VERSION/LATEST_TAG are auto-synced
// from os-tack/ostk.ai by scripts/sync-version.mjs on every build; bump
// the current entry's note when the new release lands and append the
// previous one with its own entry.
const releases = [
  {
    tag: LATEST_TAG,
    label: 'current',
    note: 'Wires the EMBED index to `search --mode embedding`; embeddings now run on Windows CI. Patch on top of v4.6.0.',
    url: RELEASE_URL,
  },
  {
    tag: 'v4.6.0',
    note: 'Daemon-only dispatch, Bounded Wait scheduler, raised FD ceiling. VFS auto-mount lifecycle (POSIX init pattern, daemon-owned). Inbox migrated to Maildir under /ostk/proc/<alias>/inbox/. Projection lattice ratified — three-tier path doctrine; standalone :ls/:cat/:tree retired in favor of VFS reads. Glyph-aware envelope rendering (four-class attention taxonomy). [health] one-line envelope replacing [procs]/[loadavg]/[meminfo]. [ctx] v2 with closed_recent + peer_activity + fleet_calls + cache panel. [attention] event-driven coordination signals. /fleet/<alias>/ operator-facing per-agent namespace. CacheAmpRegistry attributes volatile-region cache misses to peer writes.',
    url: 'https://github.com/os-tack/ostk.ai/releases/tag/v4.6.0',
  },
  {
    tag: 'v4.5.0',
    note: 'Substrate boundary ratified as a type-system invariant (→1652). VFS visibility checked structurally; the v4.4.6 string-grep lint retired in favor of the rule.',
    url: 'https://github.com/os-tack/ostk.ai/releases/tag/v4.5.0',
  },
  {
    tag: 'v4.3.0',
    note: 'System ABI introspection + CLI surface cleanup (EPIC →1589). Trust + release hardening (first-true-node patch). Spec ratifications: llmos sovereign substrate v0.1, sovereign pool whitepaper v0.1, sovereign substrate whitepaper v0.1.',
    url: 'https://github.com/os-tack/ostk.ai/releases/tag/v4.3.0',
  },
  {
    tag: 'v4.0.0',
    note: 'OAE Attestation Envelope. Provenance & security elevated to a core ostk primitive: a single verify() entry point backed by DSSE + in-toto Statement envelopes, per-vessel Policy constants, T0/T1 rotation, dual-criterion retirement gate. Seven canary vessels shipped through parallel-validate (Agentfile ATTEST, JournalSeal, bail dual-emit, ENTITYFILE, HUMANFILE + primefile, fleet-manifest + JournalSeal enforce, kernel binary release SLSA v1). Keys Store (W3C Multikey, T0 rotation, TOFU). Real sigstore-rs crypto.',
    url: 'https://github.com/os-tack/ostk.ai/releases/tag/v4.0.0',
  },
  {
    tag: 'v3.4.0',
    note: 'fcp-llm-envelope-grammar promoted from draft to spec. kernel::inject discriminator turns GREEN — full envelope set wired ([files], [maintenance], [ctx], [loadavg], [meminfo]) with byte-equality verification against the legacy dispatch path.',
    url: 'https://github.com/os-tack/ostk.ai/releases/tag/v3.4.0',
  },
  {
    tag: 'v3.2.0',
    note: 'L1.5 page table — context_store / context_load / context_pin / context_evict / context_pages MCP verbs (→1261, →1262). Windows fix + macOS codesign fix.',
    url: 'https://github.com/os-tack/ostk.ai/releases/tag/v3.2.0',
  },
  {
    tag: 'v3.0.0',
    note: 'Full Windows port: IPC abstraction (named pipes on Windows, Unix sockets on Unix), PTY via ConPTY, Win32 process management, Job Objects for process-tree termination. Clean MCP tool surface — fs_read, fs_write, edit, search. Driver-mediated enrichment hooks (fs_read + edit query drivers for diagnostics). Maildir inbox + spec for inter-agent messaging without JSONL scans. Token-efficiency architecture spec — log-structured conversations, predictive squasher, cache-aware fleet. Burn → ndarray for embeddings (cross-compile-friendly).',
    url: 'https://github.com/os-tack/ostk.ai/releases/tag/v3.0.0',
  },
  {
    tag: 'v2.5.0',
    note: 'Session topology Part X complete. SubStackHandle + ClientHandle architecture; spawn_stack + seal_stack + spawn_agent / reap_agent MCP tools. Hot-rehydrate crashed sessions with zero-restart recovery. Drain default ON + cleanup-on-reap. RevivalPolicy Reap/Ask. Sub-stack token budget aggregation. Compound-write detector + /dev/tcp detection. pin.caps deny-verb grammar enforcement.',
    url: 'https://github.com/os-tack/ostk.ai/releases/tag/v2.5.0',
  },
  {
    tag: 'v2.4.0',
    note: 'fcp-llm envelope grammar + maintenance cycle state machine (→1150). :arrive Phase 2 — presence state machine, MCP verb, drop-to-off hook. recall (formerly pitchfork) renamed; transcripts source + @witness preset. needle promote/edit verbs; atomic ID allocation under issues.lock. Context debug overlay (Opt+D). Audit coverage for every operator-initiated session verb.',
    url: 'https://github.com/os-tack/ostk.ai/releases/tag/v2.4.0',
  },
  {
    tag: 'v2.3.0',
    note: 'Unified tool surface — .language-driven verb resolution; MCP tool surface generated from .language; nine more verbs internalized (no fork+exec for boot/clock/reap/decompose/diff/ps/audit/…). Model switch handoff with lookup table. HUMANFILE BOOT/VERB extension points. ostk embeddings download for semantic search. Secret masking prevents secret values from entering LLM context. Sphere navigator (Alt+G) — embedding-clustered isolated needles, fuzzy search, temporal heat filter.',
    url: 'https://github.com/os-tack/ostk.ai/releases/tag/v2.3.0',
  },
  {
    tag: 'v2.2.9',
    note: 'ratatui TUI rewrite — custom type system deleted, seven rendering bugs closed. Approval policy chain v0.3 (capability classes, shell classifier, TRUST directive). Background daemon poller (input never blocks during tool execution). Staged + queued input buffer. Kitty keyboard protocol (Shift+Enter for newline). Bench harness — seven vendor CLIs + local Ollama models. Local LLM summarization via burn-lm. pin.caps fail-closed + scoped approval prompt + :revoke verb.',
    url: 'https://github.com/os-tack/ostk.ai/releases/tag/v2.2.9',
  },
  {
    tag: 'v2.2.1',
    note: 'Web-of-Trust identity — T0/T1/T2/T3 trust tiers via GPG cross-signatures. Trust anchors: @scottmeyer (T0), @ostk.ai root (T0). Tier-default pin enforcement (floor semantics). New files: HUMANFILE (operator context, secrets authorization), ENTITYFILE v2.1 (agent identity, capabilities, trust tier).',
    url: 'https://github.com/os-tack/ostk.ai/releases/tag/v2.2.1',
  },
  {
    tag: 'v1.0',
    note: 'Genesis release. The distributed OS.',
    url: 'https://github.com/os-tack/ostk.ai/releases/tag/v1.0',
  },
];

const canonicalUrl = new URL(Astro.url.pathname, 'https://ostk.ai').href;
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "Changelog — ostk",
  "description": "ostk release history. Hand-maintained log of recent versions with notes.",
  "image": "https://ostk.ai/og-image.png",
  "author": { "@type": "Organization", "name": "ostk", "url": "https://ostk.ai" },
  "publisher": {
    "@type": "Organization",
    "name": "ostk",
    "url": "https://ostk.ai",
    "logo": { "@type": "ImageObject", "url": "https://ostk.ai/og-image.png" },
  },
  "mainEntityOfPage": { "@type": "WebPage", "@id": canonicalUrl },
};
---

<Base
  title="Changelog — ostk"
  description="ostk release history. Last 10 versions with notes. Hand-maintained, signed binaries on GitHub, sitemap-tracked for crawlers."
>
  <script slot="schema" type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <Sidebar title="OSTK" subtitle={`${LATEST_TAG} STABLE`} groups={sidebarGroups} />

  <main id="main-content" class="flex-1 md:ml-64 pt-16 pb-12 px-4 md:px-10">
    <div class="max-w-4xl mx-auto py-12">
      <Breadcrumb crumbs={[
        { label: 'OSTK', href: '/' },
        { label: 'CHANGELOG' },
      ]} />

      <div class="section-label mb-4">RELEASE_HISTORY</div>
      <h1 class="serif-text text-6xl font-bold tracking-tighter text-on-surface mb-6">Changelog</h1>
      <p class="font-headline text-lg text-on-surface-variant italic leading-relaxed max-w-2xl mb-4">
        Hand-maintained log of recent ostk releases.
      </p>
      <p class="font-body text-sm text-secondary leading-relaxed max-w-2xl mb-12">
        Every release ships as GPG-signed binaries on the
        <a href="https://github.com/os-tack/ostk.ai/releases" class="text-primary hover:underline">releases page</a>.
        Verify signatures before installing on shared infrastructure. Current stable: <code class="text-primary">{LATEST_TAG}</code>.
      </p>

      <div class="space-y-px">
        {releases.map(release => (
          <div class="bg-surface-container grid grid-cols-1 md:grid-cols-12 gap-0">
            <div class="md:col-span-2 bg-surface-container-low flex items-center justify-center py-6 px-4">
              <div class="text-center">
                <div class="serif-text text-2xl font-bold text-primary">{release.tag}</div>
                {release.label && (
                  <div class="font-label text-[9px] uppercase tracking-widest text-secondary mt-1">{release.label}</div>
                )}
              </div>
            </div>
            <div class="md:col-span-10 p-6">
              <p class="font-body text-sm text-on-surface leading-relaxed mb-2">{release.note}</p>
              {release.url && (
                <a href={release.url} class="font-body text-[11px] text-primary hover:underline">
                  → release notes on GitHub
                </a>
              )}
            </div>
          </div>
        ))}
      </div>

      <p class="font-body text-xs text-outline mt-12 max-w-xl">
        Looking for the source of truth? See
        <a href="https://github.com/os-tack/ostk.ai/releases" class="text-primary hover:underline">github.com/os-tack/ostk.ai/releases</a>
        for every published binary, signature, and SHA-256 manifest.
      </p>
    </div>
  </main>
</Base>
