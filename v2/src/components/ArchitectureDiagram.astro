<div class="relative w-full overflow-hidden border border-surface-variant bg-surface-container-low p-4 md:p-8 mb-6">
  <div class="absolute top-3 left-4 font-mono text-[9px] text-primary uppercase tracking-widest">
    SYSTEM_COORDINATION_FLOW // LIVE_IPC_AND_INFERENCE_ROUTING
  </div>
  
  <div class="w-full overflow-x-auto">
    <div class="min-w-[860px] py-4">
      <svg viewBox="0 0 1000 600" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto select-none">
        <defs>
          <!-- Arrowhead markers -->
          <marker id="arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="#9e8e7d"/>
          </marker>
          <marker id="arrow-primary" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="#ffc169"/>
          </marker>
          <marker id="arrow-double" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="#c2c9b4"/>
          </marker>
        </defs>

        <!-- Connections (Paths & Labels) -->
        <g class="connections">
          <!-- Human -> messages -> Claude Code -->
          <path d="M 300 85 L 300 132" stroke="#9e8e7d" stroke-width="1.5" marker-end="url(#arrow)"/>
          <text x="312" y="112" fill="#c2c9b4" class="font-body text-[10px] italic">messages</text>

          <!-- Claude Code <-> /api/messages & inference <-> ostk cache -->
          <path d="M 390 162 L 502 162" stroke="#ffc169" stroke-width="1.5" marker-end="url(#arrow-primary)"/>
          <text x="450" y="153" fill="#ffc169" text-anchor="middle" class="font-body text-[10px] font-bold">/api/messages</text>

          <path d="M 510 192 L 398 192" stroke="#9e8e7d" stroke-width="1.5" marker-end="url(#arrow)"/>
          <text x="450" y="207" fill="#c2c9b4" text-anchor="middle" class="font-body text-[10px] italic">inference</text>

          <!-- ostk cache <-> projection + context & inference <-> api.anthropic.com -->
          <path d="M 690 162 L 812 162" stroke="#ffc169" stroke-width="1.5" marker-end="url(#arrow-primary)"/>
          <text x="750" y="153" fill="#ffc169" text-anchor="middle" class="font-body text-[10px] font-bold">projection + context</text>

          <path d="M 820 192 L 698 192" stroke="#9e8e7d" stroke-width="1.5" marker-end="url(#arrow)"/>
          <text x="750" y="207" fill="#c2c9b4" text-anchor="middle" class="font-body text-[10px] italic">inference</text>

          <!-- Claude Code <-> mcp <-> ostk kernel (bi-directional) -->
          <path d="M 300 228 L 300 312" stroke="#ffc169" stroke-width="2" marker-end="url(#arrow-primary)" marker-start="url(#arrow-primary)"/>
          <text x="312" y="275" fill="#ffc169" class="font-body text-[11px] font-bold">mcp (System ABI)</text>

          <!-- ostk recall -> Claude Code -->
          <path d="M 140 320 C 140 250, 190 190, 202 182" stroke="#c2c9b4" stroke-width="1.5" fill="none" marker-end="url(#arrow-double)"/>
          
          <!-- ostk recall -> ostk kernel -->
          <path d="M 180 360 L 202 360" stroke="#c2c9b4" stroke-width="1.5" marker-end="url(#arrow-double)"/>

          <!-- ostk kernel -- kernel projection -->
          <path d="M 360 320 C 420 280, 480 240, 502 212" stroke="#ffc169" stroke-width="1.5" stroke-dasharray="4 3" fill="none" marker-end="url(#arrow-primary)"/>
          <text x="460" y="275" fill="#ffc169" class="font-body text-[9px] font-bold" transform="rotate(-30 460 275)">kernel projection</text>

          <!-- ostk kernel -- conversation context -->
          <path d="M 390 335 C 470 320, 530 270, 552 222" stroke="#ffc169" stroke-width="1.5" stroke-dasharray="4 3" fill="none" marker-end="url(#arrow-primary)"/>
          <text x="495" y="305" fill="#ffc169" class="font-body text-[9px] font-bold" transform="rotate(-20 495 305)">conversation context</text>

          <!-- ostk cache -- metrics -->
          <path d="M 650 220 C 660 300, 680 400, 684 482" stroke="#c2c9b4" stroke-width="1.5" fill="none" marker-end="url(#arrow-double)"/>
          <text x="678" y="350" fill="#c2c9b4" transform="rotate(78 678 350)" class="font-body text-[10px] italic">metrics</text>

          <!-- ostk kernel <-> VFS / lock <-> Filesystem (~/project) -->
          <path d="M 320 400 L 320 482" stroke="#ffc169" stroke-width="1.5" marker-end="url(#arrow-primary)" marker-start="url(#arrow-primary)"/>
          <text x="330" y="445" fill="#ffc169" class="font-body text-[10px] font-bold">VFS / locks</text>

          <!-- Filesystem watches (dashed lines from bottom looping left and up to recall) -->
          <!-- ~/.claude to recall -->
          <path d="M 205 570 C 50 630, -20 500, 52 408" stroke="#9e8e7d" stroke-width="1.2" stroke-dasharray="3 3" fill="none" marker-end="url(#arrow)"/>
          <!-- ~/project to recall -->
          <path d="M 445 570 C 10 650, -50 480, 72 408" stroke="#9e8e7d" stroke-width="1.2" stroke-dasharray="3 3" fill="none" marker-end="url(#arrow)"/>
          <!-- ~/ostk-cache to recall -->
          <path d="M 685 570 C -30 680, -80 460, 92 408" stroke="#9e8e7d" stroke-width="1.2" stroke-dasharray="3 3" fill="none" marker-end="url(#arrow)"/>

          <!-- ~/.claude to claude code -->
          <path d="M 180 490 L 230 225" stroke="#9e8e7d" stroke-width="1" stroke-dasharray="3 3" fill="none" marker-end="url(#arrow)"/>
        </g>

        <!-- Nodes (rects + text) -->
        <!-- Human Node -->
        <g class="node human">
          <polygon points="300,20 325,45 300,70 275,45" fill="#100e0c" stroke="#9e8e7d" stroke-width="1.5"/>
          <circle cx="300" cy="40" r="4" fill="#e7e1de"/>
          <line x1="300" y1="44" x2="300" y2="56" stroke="#e7e1de" stroke-width="1.5"/>
          <line x1="295" y1="48" x2="305" y2="48" stroke="#e7e1de" stroke-width="1.5"/>
          <line x1="300" y1="56" x2="296" y2="64" stroke="#e7e1de" stroke-width="1.5"/>
          <line x1="300" y1="56" x2="304" y2="64" stroke="#e7e1de" stroke-width="1.5"/>
          <text x="300" y="83" fill="#e7e1de" text-anchor="middle" class="font-body text-[11px] font-bold">human</text>
        </g>

        <!-- Claude Code -->
        <g class="node claude-code">
          <rect x="210" y="140" width="180" height="80" fill="#1d1b19" stroke="#514536" stroke-width="1.5" class="hover:stroke-[#ffc169] transition-colors duration-300"/>
          <text x="300" y="175" fill="#e7e1de" text-anchor="middle" class="font-body text-sm font-bold">claude code</text>
          <text x="300" y="195" fill="#c2c9b4" text-anchor="middle" class="font-body text-[10px]">(or custom tool)</text>
        </g>

        <!-- ostk cache -->
        <g class="node ostk-cache">
          <rect x="510" y="140" width="180" height="80" fill="#1d1b19" stroke="#514536" stroke-width="1.5" class="hover:stroke-[#ffc169] transition-colors duration-300"/>
          <text x="600" y="175" fill="#ffc169" text-anchor="middle" class="font-body text-sm font-bold">ostk cache</text>
          <text x="600" y="195" fill="#c2c9b4" text-anchor="middle" class="font-body text-[10px]">localhost:8080</text>
        </g>

        <!-- API -->
        <g class="node api">
          <rect x="820" y="140" width="160" height="80" fill="#100e0c" stroke="#514536" stroke-width="1.5" class="hover:stroke-[#ffc169] transition-colors duration-300"/>
          <text x="900" y="185" fill="#e7e1de" text-anchor="middle" class="font-body text-xs font-bold">api.anthropic.com</text>
        </g>

        <!-- ostk recall -->
        <g class="node ostk-recall">
          <rect x="30" y="320" width="150" height="80" fill="#1d1b19" stroke="#514536" stroke-width="1.5" class="hover:stroke-[#ffc169] transition-colors duration-300"/>
          <text x="105" y="355" fill="#c2c9b4" text-anchor="middle" class="font-body text-xs font-bold">ostk recall</text>
          <text x="105" y="375" fill="#9e8e7d" text-anchor="middle" class="font-body text-[9px]">memory / vector index</text>
        </g>

        <!-- ostk kernel -->
        <g class="node ostk-kernel">
          <rect x="210" y="320" width="180" height="80" fill="#1d1b19" stroke="#ffc169" stroke-width="2" class="hover:stroke-[#ffc169] transition-colors duration-300"/>
          <text x="300" y="355" fill="#ffc169" text-anchor="middle" class="font-body text-sm font-bold">ostk kernel</text>
          <text x="300" y="375" fill="#e7e1de" text-anchor="middle" class="font-body text-[9px]">daemon & VFS</text>
        </g>

        <!-- Filesystem -->
        <g class="node filesystem">
          <!-- Container -->
          <rect x="120" y="490" width="650" height="80" fill="#100e0c" stroke="#514536" stroke-width="1.5"/>
          <text x="445" y="585" fill="#9e8e7d" text-anchor="middle" class="font-body text-[11px] font-bold uppercase tracking-wider">filesystem</text>

          <!-- Partition 1: ~/.claude -->
          <rect x="120" y="490" width="170" height="80" fill="none" stroke="#514536" stroke-width="1"/>
          <text x="205" y="535" fill="#e7e1de" text-anchor="middle" class="font-body text-xs">~/.claude</text>

          <!-- Partition 2: ~/project -->
          <rect x="290" y="490" width="310" height="80" fill="none" stroke="#514536" stroke-width="1"/>
          <text x="445" y="535" fill="#e7e1de" text-anchor="middle" class="font-body text-xs font-bold">~/project</text>

          <!-- Partition 3: ~/ostk-cache -->
          <rect x="600" y="490" width="170" height="80" fill="none" stroke="#514536" stroke-width="1"/>
          <text x="685" y="535" fill="#e7e1de" text-anchor="middle" class="font-body text-xs">~/-cache</text>
        </g>
      </svg>
    </div>
  </div>
</div>
