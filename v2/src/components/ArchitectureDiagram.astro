<div class="relative w-full overflow-hidden border border-surface-variant bg-[#110f0d] p-4 md:p-8 mb-6 rounded-lg shadow-2xl">
  <div class="absolute top-3 left-4 font-mono text-[10px] text-primary/80 uppercase tracking-widest flex items-center gap-1.5 select-none">
    <span class="inline-block w-1.5 h-1.5 bg-primary rounded-full animate-ping"></span>
    SYSTEM_COORDINATION_FLOW // LIVE_IPC_AND_INFERENCE_ROUTING
  </div>
  
  <div class="py-4">
    <svg viewBox="0 0 1000 650" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto select-none architecture-svg">
        <defs>
          <!-- Grid Pattern -->
          <pattern id="diag-grid" width="30" height="30" patternUnits="userSpaceOnUse">
            <path d="M 30 0 L 0 0 0 30" fill="none" stroke="#1d1a17" stroke-width="1.5"/>
          </pattern>

          <!-- Glow Filters for each layer -->
          <!-- Orange/Gold Glow (Kernel & MCP) -->
          <filter id="glow-gold" x="-30%" y="-30%" width="160%" height="160%">
            <feGaussianBlur stdDeviation="8" result="blur" />
            <feComponentTransfer in="blur" result="glow">
              <feFuncA type="linear" slope="0.6"/>
            </feComponentTransfer>
            <feMerge>
              <feMergeNode in="glow" />
              <feMergeNode in="SourceGraphic" />
            </feMerge>
          </filter>
          
          <!-- Blue/Cyan Glow (Cache & API Calls) -->
          <filter id="glow-blue" x="-30%" y="-30%" width="160%" height="160%">
            <feGaussianBlur stdDeviation="6" result="blur" />
            <feComponentTransfer in="blur" result="glow">
              <feFuncA type="linear" slope="0.5"/>
            </feComponentTransfer>
            <feMerge>
              <feMergeNode in="glow" />
              <feMergeNode in="SourceGraphic" />
            </feMerge>
          </filter>

          <!-- Green Glow (Recall & Memory) -->
          <filter id="glow-green" x="-30%" y="-30%" width="160%" height="160%">
            <feGaussianBlur stdDeviation="6" result="blur" />
            <feComponentTransfer in="blur" result="glow">
              <feFuncA type="linear" slope="0.5"/>
            </feComponentTransfer>
            <feMerge>
              <feMergeNode in="glow" />
              <feMergeNode in="SourceGraphic" />
            </feMerge>
          </filter>

          <!-- Gradients -->
          <linearGradient id="terminal-grad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#1e1c1a" />
            <stop offset="100%" stop-color="#151312" />
          </linearGradient>

          <linearGradient id="kernel-stroke" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#ffb84d" />
            <stop offset="100%" stop-color="#c48316" />
          </linearGradient>

          <linearGradient id="cache-stroke" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#4db8ff" />
            <stop offset="100%" stop-color="#1683c4" />
          </linearGradient>

          <linearGradient id="recall-stroke" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#81c784" />
            <stop offset="100%" stop-color="#388e3c" />
          </linearGradient>

          <!-- Arrowheads -->
          <marker id="arr-gray" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M 0 2 L 7 5 L 0 8 z" fill="#5c544c"/>
          </marker>
          <marker id="arr-gold" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M 0 2 L 7 5 L 0 8 z" fill="#ffb84d"/>
          </marker>
          <marker id="arr-blue" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M 0 2 L 7 5 L 0 8 z" fill="#4db8ff"/>
          </marker>
          <marker id="arr-green" viewBox="0 0 10 10" refX="7" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M 0 2 L 7 5 L 0 8 z" fill="#81c784"/>
          </marker>
        </defs>

        <!-- Background grid overlay -->
        <rect width="1000" height="650" fill="url(#diag-grid)" rx="8" />

        <!-- BOUNDARY SECTIONS (Sleek layout frames showing conceptual scopes) -->
        <!-- Local Sandbox Isolation Scope -->
        <rect x="20" y="110" width="760" height="400" rx="10" fill="none" stroke="#25211e" stroke-width="1.5" stroke-dasharray="8 6"/>
        <text x="35" y="130" fill="#5c544c" class="font-mono text-[9px] uppercase tracking-widest">Local Sandbox Scope (Self-Contained)</text>

        <!-- Dynamic Connection Flows with Animation -->
        <g class="flow-paths">
          <!-- 1. Human messages to Claude Code -->
          <path id="path-human-msg" d="M 170 85 L 170 142" stroke="#5c544c" stroke-width="1.5" marker-end="url(#arr-gray)"/>
          <text x="182" y="110" fill="#9e8e7d" class="font-mono text-[9px] uppercase tracking-wider">messages</text>

          <!-- 2. Claude Code API Request (Intercepted by local proxy) -->
          <!-- We show the API path physically routed into the cache proxy bridge -->
          <path id="path-intercept-out" d="M 260 162 C 340 162, 420 162, 490 162" stroke="#4db8ff" stroke-width="2" marker-end="url(#arr-blue)"/>
          <text x="375" y="152" fill="#4db8ff" text-anchor="middle" class="font-mono text-[9px] font-bold tracking-wider">/api/messages (HTTPS)</text>
          
          <!-- Animated blue pulse indicating API packets going into proxy -->
          <circle r="4" fill="#4db8ff" filter="url(#glow-blue)">
            <animateMotion dur="2.5s" repeatCount="indefinite" path="M 260 162 C 340 162, 420 162, 490 162" />
          </circle>

          <!-- 3. Local Cache Proxy forwards requests after prompt enrichment to api.anthropic.com -->
          <path id="path-forward-out" d="M 680 162 L 812 162" stroke="#4db8ff" stroke-width="1.5" marker-end="url(#arr-blue)"/>
          <text x="746" y="152" fill="#ffb84d" text-anchor="middle" class="font-mono text-[9px] font-bold tracking-wider">enriched prompt</text>
          
          <circle r="3" fill="#4db8ff" filter="url(#glow-blue)">
            <animateMotion dur="2s" repeatCount="indefinite" path="M 680 162 L 812 162" />
          </circle>

          <!-- 4. Cloud LLM responds with inference back to Proxy -->
          <path id="path-inference-in" d="M 820 192 L 688 192" stroke="#5c544c" stroke-width="1.5" marker-end="url(#arr-gray)"/>
          <text x="754" y="207" fill="#a4b399" text-anchor="middle" class="font-mono text-[9px] tracking-wider italic">raw inference</text>

          <!-- 5. Proxy passes filtered inference back to Claude Code -->
          <path id="path-inference-return" d="M 490 192 C 420 192, 340 192, 268 192" stroke="#5c544c" stroke-width="2" marker-end="url(#arr-gray)"/>
          <text x="375" y="207" fill="#a4b399" text-anchor="middle" class="font-mono text-[9px] tracking-wider italic">filtered result</text>

          <!-- 6. System calls from Claude Code to Kernel -->
          <!-- Double thick glowing line for system call boundary -->
          <path d="M 170 238 L 170 312" stroke="#ffb84d" stroke-width="2.5" marker-end="url(#arr-gold)" marker-start="url(#arr-gold)" class="glowing-kernel-link"/>
          <text x="182" y="275" fill="#ffb84d" class="font-mono text-[10px] font-bold tracking-wider">MCP System ABI</text>

          <!-- 7. Kernel Projection - Kernel automatically injects project workspace VFS state to the proxy -->
          <path id="path-kernel-projection" d="M 260 322 C 340 300, 420 250, 490 202" stroke="#ffb84d" stroke-width="1.5" stroke-dasharray="4 3" fill="none" marker-end="url(#arr-gold)"/>
          <text x="380" y="260" fill="#ffb84d" class="font-mono text-[8px] font-bold tracking-wider" transform="rotate(-31 380 260)">VFS State Projection</text>
          
          <circle r="3" fill="#ffb84d" filter="url(#glow-gold)">
            <animateMotion dur="3.5s" repeatCount="indefinite" path="M 260 322 C 340 300, 420 250, 490 202" />
          </circle>

          <!-- 8. Conversation Context - Kernel injects budget, history and token limits -->
          <path id="path-context-projection" d="M 260 350 C 360 330, 460 280, 510 215" stroke="#ffb84d" stroke-width="1.5" stroke-dasharray="4 3" fill="none" marker-end="url(#arr-gold)"/>
          <text x="410" y="300" fill="#ffb84d" class="font-mono text-[8px] font-bold tracking-wider" transform="rotate(-26 410 300)">Conversation Context</text>

          <!-- 9. Semantic Lookup: Claude Code requests vector memories -->
          <path id="path-semantic-lookup" d="M 240 230 C 270 265, 360 270, 410 320" stroke="#81c784" stroke-width="1.5" fill="none" marker-end="url(#arr-green)"/>
          <text x="320" y="270" fill="#81c784" class="font-mono text-[8px] font-bold tracking-wider" transform="rotate(22 320 270)">Semantic Query</text>

          <!-- 10. Memory feed back: Recall returns matching context blocks -->
          <path id="path-memory-return" d="M 450 320 C 400 280, 220 270, 180 230" stroke="#81c784" stroke-width="1.5" fill="none" marker-end="url(#arr-green)"/>
          <text x="290" y="280" fill="#a4b399" class="font-mono text-[8px] tracking-wider italic" transform="rotate(18 290 280)">relevant memories</text>

          <!-- 11. Kernel coordinates files with VFS layer -->
          <path d="M 220 408 C 220 450, 340 450, 380 502" stroke="#ffb84d" stroke-width="2" marker-end="url(#arr-gold)" marker-start="url(#arr-gold)"/>
          <text x="290" y="465" fill="#ffb84d" class="font-mono text-[9px] font-bold tracking-wider" transform="rotate(30 290 465)">VFS Interception / Locks</text>

          <!-- 12. Local proxy emits execution metrics for audit -->
          <path d="M 590 228 C 590 320, 590 410, 590 502" stroke="#5c544c" stroke-width="1.5" fill="none" marker-end="url(#arr-gray)"/>
          <text x="598" y="360" fill="#9e8e7d" class="font-mono text-[8px] tracking-wider italic" transform="rotate(90 598 360)">execution metrics</text>

          <!-- 13. Recall monitors filesystem changes to index files -->
          <path d="M 450 502 L 450 408" stroke="#81c784" stroke-width="1.5" stroke-dasharray="3 3" marker-end="url(#arr-green)"/>
          <text x="458" y="455" fill="#81c784" class="font-mono text-[8px] font-bold tracking-wider">re-index trigger</text>
        </g>

        <!-- NODES & METAPHORICAL CARDS -->
        <!-- Human Node (Top Operator) -->
        <g class="node-human">
          <polygon points="170,15 195,40 170,65 145,40" fill="#151312" stroke="#ffb84d" stroke-width="1.5" filter="url(#glow-gold)" class="interactive-diamond"/>
          <circle cx="170" cy="35" r="4.5" fill="#e7e1de"/>
          <line x1="170" y1="39" x2="170" y2="51" stroke="#e7e1de" stroke-width="1.5"/>
          <line x1="164" y1="44" x2="176" y2="44" stroke="#e7e1de" stroke-width="1.5"/>
          <line x1="170" y1="51" x2="165" y2="59" stroke="#e7e1de" stroke-width="1.5"/>
          <line x1="170" y1="51" x2="175" y2="59" stroke="#e7e1de" stroke-width="1.5"/>
          <text x="170" y="80" fill="#e7e1de" text-anchor="middle" class="font-mono text-[9px] font-bold tracking-widest uppercase">Operator</text>
        </g>

        <!-- Claude Code Node (Visualized as a terminal CLI application) -->
        <g class="node-terminal interactive-card">
          <!-- Terminal window shadow & background -->
          <rect x="110" y="142" width="150" height="88" rx="6" fill="url(#terminal-grad)" stroke="#4d4234" stroke-width="1.5" class="card-base"/>
          <!-- Terminal Title bar -->
          <path d="M 110 148 A 6 6 0 0 1 116 142 H 254 A 6 6 0 0 1 260 148 V 160 H 110 Z" fill="#201e1c"/>
          <!-- Window Controls -->
          <circle cx="122" cy="151" r="3" fill="#ff5f56"/>
          <circle cx="132" cy="151" r="3" fill="#ffbd2e"/>
          <circle cx="142" cy="151" r="3" fill="#27c93f"/>
          <text x="190" y="153" fill="#8c8273" text-anchor="middle" class="font-mono text-[8px] font-bold tracking-wide">claude-code</text>
          
          <!-- Terminal Content -->
          <text x="122" y="178" fill="#e7e1de" class="font-mono text-[10px]">> ostk run worker.af</text>
          <text x="122" y="193" fill="#ffb84d" class="font-mono text-[9px] animate-pulse">● active lineage</text>
          <text x="122" y="208" fill="#5c544c" class="font-mono text-[8px]">Session: scheduler_t1</text>
        </g>

        <!-- ostk cache Node (Visualized as a proxy gateway bridge) -->
        <g class="node-proxy interactive-card">
          <!-- Main Card -->
          <rect x="490" y="142" width="190" height="88" rx="6" fill="url(#terminal-grad)" stroke="url(#cache-stroke)" stroke-width="2" filter="url(#glow-blue)" class="card-base"/>
          <!-- Header banner -->
          <path d="M 490 148 A 6 6 0 0 1 496 142 H 674 A 6 6 0 0 1 680 148 V 158 H 490 Z" fill="#18232c"/>
          <text x="585" y="152" fill="#4db8ff" text-anchor="middle" class="font-mono text-[8px] font-bold tracking-widest uppercase">api middleware proxy</text>
          
          <!-- Content showing interception mechanics -->
          <text x="505" y="178" fill="#e7e1de" class="font-sans text-xs font-bold">ostk cache</text>
          <text x="505" y="195" fill="#4db8ff" class="font-mono text-[8px]">Intercept: localhost:8080</text>
          
          <!-- Action badge showing prompt injection -->
          <rect x="505" y="204" width="115" height="15" rx="3" fill="#1b2e3c" stroke="#1683c4" stroke-width="0.8"/>
          <text x="512" y="214" fill="#4db8ff" class="font-mono text-[7px] font-bold">INJECTS CONTEXT LOOPS</text>
        </g>

        <!-- External LLM API Node (Visualized as a cloud server) -->
        <g class="node-api interactive-card">
          <rect x="812" y="142" width="160" height="88" rx="6" fill="#161412" stroke="#3b3732" stroke-width="1.5" class="card-base"/>
          
          <!-- Cloud Icon -->
          <path d="M 830 185 C 830 178, 836 172, 843 172 C 846 172, 849 174, 852 176 C 855 170, 862 166, 869 166 C 878 166, 885 173, 885 181 C 889 181, 893 185, 893 189 C 893 194, 889 198, 884 198 H 830 Z" fill="#25211e" stroke="#5c544c" stroke-width="1"/>
          
          <text x="902" y="185" fill="#e7e1de" text-anchor="middle" class="font-sans text-xs font-bold">Anthropic API</text>
          <text x="902" y="198" fill="#5c544c" text-anchor="middle" class="font-mono text-[8px] tracking-wider">api.anthropic.com</text>
        </g>

        <!-- ostk recall Node (Visualized as a database / semantic lattice) -->
        <g class="node-recall interactive-card">
          <rect x="375" y="320" width="150" height="88" rx="6" fill="url(#terminal-grad)" stroke="url(#recall-stroke)" stroke-width="1.5" class="card-base"/>
          
          <!-- Network graph icon -->
          <circle cx="395" cy="342" r="3.5" fill="#81c784" filter="url(#glow-green)"/>
          <circle cx="415" cy="336" r="2.5" fill="#388e3c"/>
          <circle cx="410" cy="354" r="3" fill="#388e3c"/>
          <line x1="395" y1="342" x2="415" y2="336" stroke="#5c544c" stroke-width="1"/>
          <line x1="395" y1="342" x2="410" y2="354" stroke="#5c544c" stroke-width="1"/>
          
          <text x="450" y="344" fill="#81c784" class="font-sans text-xs font-bold">ostk recall</text>
          <text x="390" y="375" fill="#a4b399" class="font-mono text-[8px]">Index: vector db</text>
          <text x="390" y="388" fill="#5c544c" class="font-mono text-[8px]">Context-Aware retrieval</text>
        </g>

        <!-- ostk kernel Node (Visualized as a high-tech processor / daemon VFS) -->
        <g class="node-kernel interactive-card">
          <!-- Glow background -->
          <rect x="110" y="320" width="150" height="88" rx="6" fill="url(#terminal-grad)" stroke="url(#kernel-stroke)" stroke-width="2" filter="url(#glow-gold)" class="card-base active-kernel"/>
          
          <!-- Animated blinking dot representing operational daemon -->
          <circle cx="125" cy="336" r="3.5" fill="#ffb84d" class="blinking-dot"/>
          <text x="190" y="340" fill="#ffb84d" text-anchor="middle" class="font-mono text-[9px] font-bold tracking-widest uppercase">kernel core</text>
          
          <text x="125" y="365" fill="#e7e1de" class="font-sans text-xs font-bold">ostk kernel</text>
          <text x="125" y="382" fill="#a4b399" class="font-mono text-[8px]">State: daemon active</text>
          <text x="125" y="394" fill="#5c544c" class="font-mono text-[7px]">Syscalls: read/write/bash</text>
        </g>

        <!-- Filesystem Node (Visualized as partitioned volumes) -->
        <g class="node-filesystem">
          <!-- Container -->
          <rect x="120" y="502" width="650" height="88" rx="8" fill="#151312" stroke="#4d4234" stroke-width="1.5"/>
          <text x="445" y="605" fill="#9e8e7d" text-anchor="middle" class="font-mono text-[10px] font-bold uppercase tracking-widest">governed local filesystem</text>

          <!-- Partition 1: ~/.claude (Agent State) -->
          <line x1="290" y1="502" x2="290" y2="590" stroke="#25211e" stroke-width="1.5"/>
          <g class="fs-folder">
            <!-- Sleek Folder Outline -->
            <path d="M 145 530 H 155 L 159 535 H 175 V 555 H 145 Z" fill="#25211e" stroke="#5c544c" stroke-width="1.2"/>
            <text x="185" y="546" fill="#e7e1de" class="font-sans text-xs font-bold">~/.claude</text>
            <text x="185" y="558" fill="#5c544c" class="font-mono text-[8px]">Agent internal caches</text>
          </g>

          <!-- Partition 2: ~/project (Main Governed Workspace) -->
          <line x1="600" y1="502" x2="600" y2="590" stroke="#25211e" stroke-width="1.5"/>
          <g class="fs-folder">
            <path d="M 320 530 H 330 L 334 535 H 350 V 555 H 320 Z" fill="#ffb84d" fill-opacity="0.1" stroke="#ffb84d" stroke-width="1.2"/>
            <!-- Visual lock indicating VFS protection -->
            <rect x="365" y="535" width="8" height="6" rx="1" fill="#ffb84d"/>
            <path d="M 367 535 V 532 C 367 530, 371 530, 371 532 V 535" stroke="#ffb84d" stroke-width="1" fill="none"/>
            <text x="382" y="546" fill="#ffb84d" class="font-sans text-xs font-bold">~/project</text>
            <text x="320" y="572" fill="#a4b399" class="font-mono text-[8px]">VFS projection / OCC checks (.ostk/)</text>
          </g>

          <!-- Partition 3: ~/ostk-cache (Proxy Cache store) -->
          <g class="fs-folder">
            <path d="M 625 530 H 635 L 639 535 H 655 V 555 H 625 Z" fill="#25211e" stroke="#5c544c" stroke-width="1.2"/>
            <text x="665" y="546" fill="#e7e1de" class="font-sans text-xs font-bold">~/-cache</text>
            <text x="665" y="558" fill="#5c544c" class="font-mono text-[8px]">Cached prompt segments</text>
          </g>
        </g>
      </svg>
    </div>
  </div>

<style>
  /* Premium Architecture Diagram Styling */
  .architecture-svg {
    font-family: 'Outfit', 'Inter', system-ui, -apple-system, sans-serif;
  }

  /* Blinking active dot animation */
  @keyframes blink-dot {
    0%, 100% { opacity: 0.4; }
    50% { opacity: 1; filter: drop-shadow(0 0 3px #ffb84d); }
  }
  .blinking-dot {
    animation: blink-dot 2s infinite ease-in-out;
  }

  /* Kernel Link Flow Animation */
  @keyframes pulse-flow {
    0% { stroke-dashoffset: 0; }
    100% { stroke-dashoffset: -20; }
  }
  .glowing-kernel-link {
    stroke-dasharray: 6 4;
    animation: pulse-flow 6s infinite linear;
  }

  /* Hover Cards scaling & deep glowing shadows */
  .interactive-card {
    cursor: pointer;
  }
  
  .interactive-card .card-base {
    transition: stroke 0.3s, fill 0.3s, filter 0.3s, transform 0.3s;
  }
  
  .interactive-card:hover .card-base {
    stroke: #ffb84d;
    transform: translateY(-2px);
    filter: drop-shadow(0 8px 16px rgba(255, 184, 77, 0.15));
  }

  .interactive-card.active-kernel:hover .card-base {
    stroke: #ffb84d;
    filter: drop-shadow(0 8px 24px rgba(255, 184, 77, 0.3));
  }

  .interactive-diamond {
    transition: fill 0.3s, stroke 0.3s, filter 0.3s;
    cursor: pointer;
  }
  .interactive-diamond:hover {
    fill: #ffb84d;
    stroke: #ffffff;
    filter: url(#glow-gold);
  }
</style>
