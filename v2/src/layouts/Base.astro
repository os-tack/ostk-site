---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  activeTab?: 'why' | 'stack' | 'start' | 'docs';
  marketing?: boolean;
  noindex?: boolean;
}

const { title, description, activeTab, marketing = false, noindex = false } = Astro.props;
const pageTitle = title.toLowerCase().includes('ostk') ? title : `${title} — ostk`;
const metaDescription = description || 'Open-source project infrastructure for supported AI coding agents: canonical project state, coordination, and audit that outlive a session.';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const socialImageUrl = new URL('/og-image.png', Astro.site).href;
const robotsContent = noindex
  ? 'noindex,follow'
  : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1';
---

<!DOCTYPE html>
<html class="dark" lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={metaDescription} />
  <meta name="robots" content={robotsContent} />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-readable site index" />
  <!-- Open Graph -->
  <meta property="og:site_name" content="ostk" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:image" content={socialImageUrl} />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:alt" content="ostk — project state that outlives the agent" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:type" content="website" />
  <!-- Twitter/X -->
  <meta name="twitter:card" content="summary_large_image" />
  {/* TODO: confirm @ostkai twitter/X handle exists; add `<meta name="twitter:site" content="@ostkai" />` when confirmed. */}
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={metaDescription} />
  <meta name="twitter:image" content={socialImageUrl} />
  <meta name="twitter:image:alt" content="ostk — project state that outlives the agent" />
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&family=Space+Grotesk:wght@300..700&display=swap" rel="stylesheet" />
  <!-- Material Symbols removed — using inline SVG Icon component -->
  <!-- Plausible Analytics — privacy-first, cookie-free. Tagged-events variant supports `plausible-event-name=...` class tags + auto outbound-link tracking + file-download tracking. -->
  <script defer data-domain="ostk.ai" src="https://plausible.io/js/script.tagged-events.outbound-links.file-downloads.js"></script>
  <script is:inline>window.plausible=window.plausible||function(){(window.plausible.q=window.plausible.q||[]).push(arguments)}</script>

</head>
<body class="flex flex-col min-h-screen">
  <Header activeTab={activeTab} marketing={marketing} />
  <slot />
  <Footer compact={marketing} />
  <slot name="schema" />
  <script is:inline>
    document.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-copy]');
      if (!btn) return;
      const text = btn.getAttribute('data-copy') || '';
      if (navigator.clipboard) navigator.clipboard.writeText(text).catch(() => {});
      const prev = btn.getAttribute('data-copied-label');
      if (!prev) {
        btn.setAttribute('data-copied-label', '1');
        const orig = btn.innerHTML;
        btn.innerHTML = '<span class="text-outline select-none">$ </span><span class="text-primary">copied — paste in a terminal</span>';
        setTimeout(() => { btn.innerHTML = orig; btn.removeAttribute('data-copied-label'); }, 1400);
      }
    });
  </script>
</body>
</html>
